<Window x:Class="RoDeck.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22">
    <TextBlock x:Name="Prompt" Margin="0,0,0,10" TextWrapping="Wrap"/>
    <TextBox x:Name="Input"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="Cancel" IsCancel="True"/>
      <Button Content="OK" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
