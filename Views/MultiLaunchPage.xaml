<UserControl x:Class="AltDeck.Views.MultiLaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AltDeck.Views">
  <!-- Multi-launch: everything AltDeck did before 0.5, as tabs. Each tab is the page it used to be. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="32,22,32,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"
                   Foreground="{DynamicResource Accent}" Margin="0,0,10,0"/>
        <TextBlock Text="Multi-launch" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0"/>

        <RadioButton Style="{StaticResource Seg}" GroupName="multitab"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Running, Mode=TwoWay}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Running"/>
            <Border Background="{DynamicResource Card2}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0">
              <TextBlock Text="{Binding RunningCount}" FontSize="11"/>
            </Border>
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab" Content="Launch"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Launch, Mode=TwoWay}"/>
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Accounts, Mode=TwoWay}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Accounts"/>
            <Border Background="{DynamicResource Card2}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0">
              <TextBlock Text="{Binding AccountCount}" FontSize="11"/>
            </Border>
            <Border Background="{DynamicResource Red}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                    ToolTip="{Binding ExpiredSignInText}"
                    Visibility="{Binding HasExpiredSignIns, Converter={StaticResource BoolVis}}">
              <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White">
                <Run Text="&#x26A0;"/><Run Text=" "/><Run Text="{Binding NeedsSignInCount, Mode=OneWay}"/>
              </TextBlock>
            </Border>
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab" Content="Activity" Margin="0"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Activity, Mode=TwoWay}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <views:HomePage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Running}"/>
      <views:PlayPage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Launch}"/>
      <views:AccountsPage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Accounts}"/>
      <views:ActivityPage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Activity}"/>
    </Grid>
  </Grid>
</UserControl>
