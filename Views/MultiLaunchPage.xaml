<UserControl x:Class="RoDeck.Views.MultiLaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RoDeck.Views">
  <!-- Multi-launch: one header (title, tabs, Hold to stop all); each tab below is its own view without a second title. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Margin="32,26,32,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="Multi-launch" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Run many accounts at once: launch them, keep them in the game, and see what happened."
                   Margin="0,4,0,0" Style="{StaticResource MutedText}"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Running, Mode=TwoWay}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Running" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
              <TextBlock Text="{Binding RunningCount}" Style="{StaticResource BadgeText}"/>
            </Border>
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab" Content="Launch"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Launch, Mode=TwoWay}"/>
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Accounts, Mode=TwoWay}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Accounts" VerticalAlignment="Center"/>
            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
              <TextBlock Text="{Binding AccountCount}" Style="{StaticResource BadgeText}"/>
            </Border>
            <Border Style="{StaticResource Badge}" Background="{DynamicResource Red}" Margin="6,0,0,0"
                    ToolTip="{Binding ExpiredSignInText}"
                    Visibility="{Binding HasExpiredSignIns, Converter={StaticResource BoolVis}}">
              <TextBlock Style="{StaticResource BadgeText}" Foreground="White">
                <Run Text="&#x26A0;"/><Run Text=" "/><Run Text="{Binding NeedsSignInCount, Mode=OneWay}"/>
              </TextBlock>
            </Border>
          </StackPanel>
        </RadioButton>
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab" Content="Farming"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Farming, Mode=TwoWay}"/>
        <RadioButton Style="{StaticResource Seg}" GroupName="multitab" Content="Activity" Margin="0"
                     IsChecked="{Binding MultiTab, Converter={StaticResource Eq}, ConverterParameter=Activity, Mode=TwoWay}"/>
      </StackPanel>

      <!-- hold for a second: closes every client, cancels the launch queue and pending rejoins -->
      <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,0,0">
        <Button x:Name="HoldBtn" Style="{StaticResource Danger}" Margin="0" Padding="16,9"
                ToolTip="Hold for 1 second: closes every Roblox client RoDeck runs, and stops the launch queue and rejoins">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Hold to stop all"/>
          </StackPanel>
        </Button>
        <ProgressBar x:Name="HoldBar" Height="3" Maximum="100" VerticalAlignment="Bottom" Margin="12,0,12,4"
                     Foreground="White" Background="Transparent" BorderThickness="0"
                     IsHitTestVisible="False" Visibility="Collapsed"/>
      </Grid>
    </Grid>

    <Grid Grid.Row="1">
      <views:HomePage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Running}"/>
      <views:PlayPage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Launch}"/>
      <views:AccountsPage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Accounts}"/>
      <views:FarmingPage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Farming}"/>
      <views:ActivityPage Visibility="{Binding MultiTab, Converter={StaticResource PageVis}, ConverterParameter=Activity}"/>
    </Grid>
  </Grid>
</UserControl>
