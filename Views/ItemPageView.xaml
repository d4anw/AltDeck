<UserControl x:Class="RoDeck.Views.ItemPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls">
  <StackPanel>
    <Button Style="{StaticResource Subtle}" HorizontalAlignment="Left" Command="{Binding CloseLimitedCommand}" Margin="-8,0,0,10">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding LimitedBackText}"/>
      </StackPanel>
    </Button>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="28"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBox}" Padding="0" CornerRadius="20" Height="300" VerticalAlignment="Top">
        <ctl:RemoteImage Url="{Binding OpenLimitedPicture}" CornerRadius="19"/>
      </Border>
      <StackPanel Grid.Column="2">
        <TextBlock Text="{Binding OpenLimited.Name}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Border Padding="8,2" CornerRadius="7" Background="{DynamicResource Card2}" Margin="0,0,6,0"
                  Visibility="{Binding OpenLimitedInfo.Projected, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
            <TextBlock Text="Projected" FontSize="11" ToolTip="RAP was pushed up and isn't a fair price"/>
          </Border>
          <Border Padding="8,2" CornerRadius="7" Background="{DynamicResource Card2}" Margin="0,0,6,0"
                  Visibility="{Binding OpenLimitedInfo.Rare, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
            <TextBlock Text="Rare" FontSize="11"/>
          </Border>
          <Border Padding="8,2" CornerRadius="7" Background="{DynamicResource Card2}"
                  Visibility="{Binding OpenLimitedInfo.Hyped, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
            <TextBlock Text="Hyped" FontSize="11"/>
          </Border>
        </StackPanel>

        <UniformGrid Columns="2" Margin="0,18,0,0">
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Type" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding OpenStats.TypeText, FallbackValue='…'}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Acronym" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding OpenStats.AcronymText, FallbackValue='…'}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16" ToolTip="How many copies exist now (Roblox). Rolimons' 'available' and 'premium' copies come from their own owner scans, which aren't public.">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Copies" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding OpenStats.CopiesText, FallbackValue='…'}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16" ToolTip="The RAP if someone buys the cheapest copy now: RAP moves 10% toward each sale's price.">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="RAP after sale" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding OpenStats.RapAfterSaleText, FallbackValue='…'}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16" ToolTip="Sales per day over the last 30 days">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Avg daily sales" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding OpenStats.AvgDailyText, FallbackValue='…'}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Sold in 30 days" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding OpenStats.Sold30Text, FallbackValue='…'}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Trend" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding OpenStats.TrendText, FallbackValue='…'}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
          <Button Style="{StaticResource Primary}" ctl:Btn.Icon="&#xE7BF;" Content="{Binding LimitedBuyText}" Command="{Binding BuyCheapestLimitedCommand}" IsEnabled="{Binding CanBuyLimited}" ToolTip="The cheapest copy, on a confirm card first"/>
          <Button Content="Rolimons page" ctl:Btn.External="True" Command="{Binding OpenLimitedOnRolimonsCommand}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <UniformGrid Columns="4" Margin="0,20,-12,0">
          <Border Style="{StaticResource CardBox}" Padding="16,12" Margin="0,0,12,0" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Accent}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Best price" FontSize="12" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="{Binding OpenStats.BestPriceText, FallbackValue='…'}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource CardBox}" Padding="16,12" Margin="0,0,12,0" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Accent}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="RAP" FontSize="12" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="{Binding OpenStats.RapText, FallbackValue='…'}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource CardBox}" Padding="16,12" Margin="0,0,12,0" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Accent}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Value" FontSize="12" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="{Binding OpenStats.ValueText, FallbackValue='…'}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource CardBox}" Padding="16,12" Margin="0,0,12,0" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Accent}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE8E1;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Demand" FontSize="12" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="{Binding OpenStats.DemandText, FallbackValue='…'}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>
    </UniformGrid>

    <TextBlock Text="RAP over the last year" FontWeight="SemiBold" Margin="0,24,0,8"/>
    <ctl:StateView State="{Binding LimitedLoad.State}" Message="{Binding LimitedLoad.Message}" MinHeight="120">
      <Border Style="{StaticResource CardBox}" Padding="18,16">
        <StackPanel>
          <!-- hover anywhere on it: that day's RAP and the value -->
          <Grid x:Name="ChartArea" Height="160" Background="Transparent" MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave" ClipToBounds="False">
            <Viewbox Stretch="Fill">
              <Canvas Width="600" Height="140">
                <Polyline Points="{Binding RapChart}" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
            <Canvas IsHitTestVisible="False">
              <Line x:Name="HoverLine" Y1="0" Y2="160" Stroke="{DynamicResource Muted}" StrokeThickness="1" StrokeDashArray="3 3" Visibility="Collapsed"/>
              <Ellipse x:Name="HoverDot" Width="10" Height="10" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Card}" StrokeThickness="2" Visibility="Collapsed"/>
              <Border x:Name="HoverTip" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                      CornerRadius="10" Padding="12,8" Visibility="Collapsed">
                <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.35" Color="Black"/></Border.Effect>
                <StackPanel>
                  <TextBlock x:Name="HoverDate" FontSize="11" Style="{StaticResource MutedText}"/>
                  <TextBlock Margin="0,3,0,0"><Run Text="RAP " Foreground="{DynamicResource Muted}"/><Run x:Name="HoverRap" FontWeight="Bold"/></TextBlock>
                  <TextBlock Margin="0,1,0,0"><Run x:Name="HoverValueLabel" Text="Value " Foreground="{DynamicResource Muted}"/><Run x:Name="HoverValue" FontWeight="Bold" Foreground="{DynamicResource Accent}"/></TextBlock>
                </StackPanel>
              </Border>
            </Canvas>
          </Grid>
          <TextBlock Text="{Binding RapChartRange}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </ctl:StateView>

    <!-- who resells it, cheapest first -->
    <Grid Margin="0,24,0,8">
      <TextBlock Text="Sellers" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" HorizontalAlignment="Right" Margin="0" Width="30" Height="30"
              ToolTip="Check again" Command="{Binding ReloadLimitedSellersCommand}"/>
    </Grid>
    <Border Style="{StaticResource CardBox}" Padding="6">
      <StackPanel>
        <ProgressBar IsIndeterminate="True" Height="2" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="Transparent" Margin="10,6"
                     Visibility="{Binding LimitedSellersLoading, Converter={StaticResource BoolVis}}"/>
        <TextBlock Text="{Binding LimitedSellersNote}" Style="{StaticResource MutedText}" Margin="12,10" TextWrapping="Wrap"
                   Visibility="{Binding LimitedSellersNote, Converter={StaticResource EmptyCollapsed}}"/>
        <ItemsControl ItemsSource="{Binding LimitedSellers}" SizeChanged="Sellers_SizeChanged">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" Loaded="SellersGrid_Loaded"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="row" CornerRadius="10" Padding="14,9" Margin="4" Background="{DynamicResource Card2}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                      <TextBlock Text=" ✓" Foreground="{DynamicResource Accent}" Visibility="{Binding Verified, Converter={StaticResource BoolVis}}"/>
                      <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Margin="8,0,0,0"
                              Visibility="{Binding IsYours, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Yours" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Accent}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SerialText}" FontSize="11" Style="{StaticResource MutedText}"
                               Visibility="{Binding SerialText, Converter={StaticResource EmptyCollapsed}}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,14,0"/>
                  <Button Grid.Column="2" Content="Buy" Padding="16,6" Margin="0" Focusable="False"
                          IsEnabled="{Binding IsYours, Converter={StaticResource Not}}"
                          Command="{Binding DataContext.BuyLimitedSellerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Load more" ctl:Btn.Icon="&#xE70D;" HorizontalAlignment="Center" Margin="0,6,0,6" Command="{Binding LoadMoreLimitedSellersCommand}"
                Visibility="{Binding LimitedSellersHasMore, Converter={StaticResource BoolVis}}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
