<UserControl x:Class="RoDeck.Views.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls">
  <UserControl.Resources>
    <Style x:Key="RowTitle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="2,0,6,0"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <!-- ================= the list: charts, search, favourites, recently played ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsGameOpen, Converter={StaticResource BoolVisInv}}">
      <StackPanel Margin="32,26,32,32">
        <Grid>
          <TextBlock Text="Games" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ctl:SearchBox Width="320" Margin="0,0,10,0" Text="{Binding GameSearchText}" Placeholder="Search games, press Enter"
                           SubmitCommand="{Binding SearchGamesCommand}" SubmitOnClear="True"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Refresh" Margin="0" Command="{Binding RefreshGamesCommand}"/>
          </StackPanel>
        </Grid>

        <ctl:StateView State="{Binding ChartsLoad.State}" Message="{Binding ChartsLoad.Message}" MinHeight="260" Margin="0,8,0,0"
                       EmptyText="No games here." RetryCommand="{Binding RefreshGamesCommand}">
          <Grid>
            <!-- every chart as a row, like Home; the title and its arrow open the whole chart -->
            <ItemsControl ItemsSource="{Binding GameRows}" Visibility="{Binding GamesOverview, Converter={StaticResource BoolVis}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <Grid Margin="0,18,0,10">
                      <Button Style="{StaticResource RowTitle}" HorizontalAlignment="Left"
                              Command="{Binding DataContext.SelectChartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding Id}" ToolTip="See all">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center"
                                     Margin="0,1,9,0" Foreground="{DynamicResource Accent}" Visibility="{Binding Icon, Converter={StaticResource EmptyCollapsed}}"/>
                          <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                          <TextBlock x:Name="arrow" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"
                                     Margin="10,3,0,0"/>
                        </StackPanel>
                      </Button>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="30" Height="30" Click="ScrollLeft_Click" Tag="{Binding ElementName=Row}"/>
                        <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="30" Height="30" Margin="0" Click="ScrollRight_Click" Tag="{Binding ElementName=Row}"/>
                      </StackPanel>
                    </Grid>
                    <!-- room above the cards, so a card that lifts on hover isn't cut off -->
                    <ScrollViewer x:Name="Row" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,-6,0,0"
                                  PreviewMouseWheel="Row_Wheel">
                      <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameTileTemplate}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- one chart, search results, favourites or recently played: all of it -->
            <StackPanel Visibility="{Binding GamesOverview, Converter={StaticResource BoolVisInv}}">
              <Button Style="{StaticResource Subtle}" HorizontalAlignment="Left" Command="{Binding ShowGameRowsCommand}" Margin="-8,14,0,6">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="All charts"/>
                </StackPanel>
              </Button>
              <TextBlock Text="{Binding GamesTitle}" FontSize="22" FontWeight="Bold" Margin="2,0,0,2"/>
              <TextBlock Text="{Binding GamesInfo}" Margin="2,0,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                         Visibility="{Binding GamesInfo, Converter={StaticResource EmptyCollapsed}}"/>
              <ItemsControl ItemsSource="{Binding ShownGames}" ItemTemplate="{StaticResource GameTileTemplate}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="Nothing here yet." Style="{StaticResource MutedText}" Margin="2,8,0,0"
                         Visibility="{Binding ShownGames.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>
            </StackPanel>
          </Grid>
        </ctl:StateView>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= one game ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsGameOpen, Converter={StaticResource BoolVis}}">
      <StackPanel Margin="32,22,32,32">
        <Button Style="{StaticResource Subtle}" HorizontalAlignment="Left" Command="{Binding CloseGameCommand}" Margin="-8,0,0,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding GamesTitle, StringFormat='Back to {0}'}"/>
          </StackPanel>
        </Button>

        <ctl:StateView State="{Binding GameLoad.State}" Message="{Binding GameLoad.Message}" MinHeight="300"
                       RetryCommand="{Binding RetryOpenGameCommand}">
          <StackPanel>
            <!-- top: pictures left, info right -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <Grid>
                  <Viewbox Stretch="Uniform">
                    <ctl:RemoteImage Url="{Binding SelectedMedia}" Width="768" Height="432" CornerRadius="28"/>
                  </Viewbox>
                </Grid>
                <ItemsControl ItemsSource="{Binding OpenGame.Media}" Margin="0,10,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Padding="0" Margin="0,0,8,8" Cursor="Hand"
                              Command="{Binding DataContext.ShowMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate>
                        </Button.Template>
                        <ctl:RemoteImage Url="{Binding}" Width="96" Height="54" CornerRadius="8"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- right: name, stat cards that fill the height of the picture, then play -->
              <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <ctl:RemoteImage Url="{Binding OpenGame.IconUrl}" Width="84" Height="84" CornerRadius="18"/>
                  <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="320">
                    <TextBlock Text="{Binding OpenGame.Name}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding OpenGameMeta}" Margin="0,4,0,0" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding OpenGameStatCards}" Margin="-5,14,-5,10" MinHeight="230">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" Rows="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="5" CornerRadius="14" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" Padding="16,12">
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top" Margin="0,2,12,0">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="Bold"/>
                              <Ellipse Width="8" Height="8" Fill="{DynamicResource Green}" Margin="8,2,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding Live, Converter={StaticResource BoolVis}}" ToolTip="Live"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12" Margin="0,1,0,0"/>
                            <TextBlock Text="{Binding Sub}" FontSize="11" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <!-- likes: green for up, red for down -->
                            <Grid Height="4" Margin="0,7,0,0" Visibility="{Binding HasBar, Converter={StaticResource BoolVis}}">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding UpWidth}"/><ColumnDefinition Width="{Binding DownWidth}"/></Grid.ColumnDefinitions>
                              <Border CornerRadius="2,0,0,2" Background="{DynamicResource Green}"/>
                              <Border Grid.Column="1" CornerRadius="0,2,2,0" Background="{DynamicResource Red}" Opacity="0.8"/>
                            </Grid>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2">
                <Button Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="16,13"
                        Command="{Binding PlayOpenGameCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock FontWeight="SemiBold"><Run Text="Play as"/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue='…'}"/></TextBlock>
                  </StackPanel>
                </Button>
                <UniformGrid Columns="3">
                  <Button Content="With alts…" ctl:Btn.Icon="&#xE716;" Margin="0,0,8,0" Command="{Binding PlayOpenGameWithAltsCommand}"
                          ToolTip="Fill this game in Multi-launch → Launch to pick several accounts"/>
                  <Button Margin="0,0,8,0" Command="{Binding ToggleFavouriteGameCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE734;"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding OpenGameIsFavourite}" Value="True">
                                <Setter Property="Text" Value="&#xE735;"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="Favourite"/>
                    </StackPanel>
                  </Button>
                  <Button Content="Roblox.com" ctl:Btn.External="True" Margin="0" Command="{Binding OpenGameOnWebCommand}"/>
                </UniformGrid>
                </StackPanel>
              </Grid>
            </Grid>

            <!-- description -->
            <Border Style="{StaticResource CardBox}" Margin="0,22,0,0" Padding="22,18">
              <StackPanel>
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding OpenGame.Description}" TextWrapping="Wrap" LineHeight="21" Style="{StaticResource MutedText}"/>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <!-- server finder -->
            <Border Style="{StaticResource CardBox}" Margin="0,16,0,0" Padding="22,18">
              <StackPanel>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="Servers" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ServersInfo}" FontSize="12" Margin="0,2,0,0" Style="{StaticResource MutedText}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Best server with alts…" ctl:Btn.Icon="&#xE716;" Command="{Binding JoinServerWithAltsCommand}"
                            ToolTip="Fill the lowest-ping server in Multi-launch → Launch"/>
                    <Button Style="{StaticResource Primary}" Margin="0" Command="{Binding JoinBestServerCommand}"
                            ToolTip="Join the server with the lowest ping that has room, with the account top right">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Join best server"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,10">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Seg}" Content="Best ping" GroupName="serversort"
                                 IsChecked="{Binding ServerSort, Converter={StaticResource Eq}, ConverterParameter=Ping, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource Seg}" Content="Fewest players" GroupName="serversort"
                                 IsChecked="{Binding ServerSort, Converter={StaticResource Eq}, ConverterParameter=Fewest, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource Seg}" Content="Most players" GroupName="serversort"
                                 IsChecked="{Binding ServerSort, Converter={StaticResource Eq}, ConverterParameter=Most, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource Seg}" Content="Friends first" GroupName="serversort" Margin="0"
                                 IsChecked="{Binding ServerSort, Converter={StaticResource Eq}, ConverterParameter=Friends, Mode=TwoWay}"/>
                  </StackPanel>
                  <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" HorizontalAlignment="Right" Margin="0"
                          ToolTip="Find servers again" Command="{Binding RefreshServersCommand}"/>
                </Grid>

                <!-- column titles -->
                <Grid Margin="10,0,10,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Ping" FontSize="12" Style="{StaticResource MutedText}"
                             ToolTip="Roblox's figure for the server: the average ping of the players in it. Servers near you usually show lower."/>
                  <TextBlock Grid.Column="1" Text="Players" FontSize="12" Style="{StaticResource MutedText}"/>
                </Grid>

                <ctl:StateView State="{Binding ServersLoad.State}" Message="{Binding ServersLoad.Message}" MinHeight="140"
                               EmptyText="No public servers with room right now." RetryCommand="{Binding RefreshServersCommand}">
                  <ItemsControl ItemsSource="{Binding Servers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Card2}" CornerRadius="12" Padding="10,8" Margin="0,0,0,6">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="110"/>
                              <ColumnDefinition Width="200"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding PingLevel}" Value="0"><Setter Property="Fill" Value="#3DDC84"/></DataTrigger>
                                      <DataTrigger Binding="{Binding PingLevel}" Value="2"><Setter Property="Fill" Value="{DynamicResource Red}"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                              <TextBlock Text="{Binding PingText}" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <ProgressBar Width="110" Height="6" Maximum="1" Value="{Binding Fill, Mode=OneWay}" BorderThickness="0"
                                           Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" Margin="0,0,10,0"/>
                              <TextBlock Text="{Binding PlayersText}" FontFamily="Consolas"/>
                            </StackPanel>
                            <Border Grid.Column="2" HorizontalAlignment="Left" Background="{DynamicResource Page}" CornerRadius="9" Padding="9,2"
                                    VerticalAlignment="Center" Visibility="{Binding HasFriends, Converter={StaticResource BoolVis}}"
                                    ToolTip="{Binding Friends}">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Friends}" FontSize="11" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                              <Button Content="Alts…" ctl:Btn.Icon="&#xE716;" Padding="12,6"
                                      Command="{Binding DataContext.JoinServerWithAltsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                              <Button Content="Join" ctl:Btn.Icon="&#xE768;" Style="{StaticResource Primary}" Padding="16,6" Margin="0"
                                      Command="{Binding DataContext.JoinServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ctl:StateView>
              </StackPanel>
            </Border>
          </StackPanel>
        </ctl:StateView>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
