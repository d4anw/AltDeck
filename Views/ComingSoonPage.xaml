<UserControl x:Class="AltDeck.Views.ComingSoonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <!-- A page that's on the roadmap but not built yet: what it will do and in which version. -->
  <Grid Margin="32,26,32,32">
    <Border Style="{StaticResource CardBox}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Padding="36,32">
      <StackPanel>
        <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Card2}" HorizontalAlignment="Center">
          <TextBlock Text="{Binding Icon, ElementName=Root}" FontFamily="{StaticResource Icons}" FontSize="28"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
        </Border>
        <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,4"/>
        <Border HorizontalAlignment="Center" Background="{DynamicResource Card2}" CornerRadius="9" Padding="10,3" Margin="0,0,0,18">
          <TextBlock FontSize="12" Foreground="{DynamicResource Accent}">
            <Run Text="Coming in"/> <Run Text="{Binding Version, ElementName=Root, Mode=OneWay}"/>
          </TextBlock>
        </Border>
        <TextBlock Text="{Binding Body, ElementName=Root}" TextWrapping="Wrap" LineHeight="22" Style="{StaticResource MutedText}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
