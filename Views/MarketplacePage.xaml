<UserControl x:Class="RoDeck.Views.MarketplacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls"
             xmlns:local="clr-namespace:RoDeck.Views">
  <UserControl.Resources>
    <!-- a selected chip: accent border and text -->
    <Style x:Key="MarketChipBtn" TargetType="Button" BasedOn="{StaticResource Chip}">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="MarketTile">
      <Button Width="160" Margin="0,0,14,14" Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}"
              Command="{Binding DataContext.OpenMarketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="14">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.14">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.18">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel>
          <Grid>
            <Border Height="158" CornerRadius="13,13,0,0" Background="{DynamicResource Card2}"/>
            <ctl:RemoteImage Url="{Binding ThumbUrl}" Height="158" CornerRadius="13" TopCornersOnly="True"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="7,2" CornerRadius="7"
                    Background="{DynamicResource Accent}" Visibility="{Binding IsLimited, Converter={StaticResource BoolVis}}">
              <TextBlock Text="LIMITED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentFg}"/>
            </Border>
          </Grid>
          <StackPanel Margin="10,9,10,10">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding CreatorName}" FontSize="11" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFree}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Buyable}" Value="False">
                      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding PriceNote}" FontSize="11" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding PriceNote, Converter={StaticResource EmptyCollapsed}}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- ================= browsing ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsMarketItemOpen, Converter={StaticResource BoolVisInv}}">
      <StackPanel Margin="32,26,32,32">
        <Grid>
          <TextBlock Text="Marketplace" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ctl:SearchBox Width="320" Margin="0,0,10,0" Text="{Binding MarketSearchText}" Placeholder="Search items, press Enter"
                           SubmitCommand="{Binding SearchMarketCommand}" SubmitOnClear="True"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Refresh" Margin="0" Command="{Binding RefreshMarketCommand}"/>
          </StackPanel>
        </Grid>

        <!-- categories, then the selected one's subcategories -->
        <ItemsControl ItemsSource="{Binding MarketCats}" Margin="0,18,0,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource MarketChipBtn}" Content="{Binding Name}"
                      Command="{Binding DataContext.SelectMarketCatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding MarketSubs}" Margin="0,2,0,0"
                      Visibility="{Binding MarketSubs.Count, Converter={StaticResource CountVis}}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource MarketChipBtn}" Content="{Binding Name}" FontSize="12" Padding="12,5"
                      Command="{Binding DataContext.SelectMarketSubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- title left, filters right -->
        <Grid Margin="0,10,0,14">
          <TextBlock Text="{Binding MarketTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,0,0"
                     TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <CheckBox Content="Limiteds only" IsChecked="{Binding MarketLimitedsOnly}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <ComboBox Width="150" Margin="0,0,10,0" ItemsSource="{Binding MarketPrices}" SelectedItem="{Binding MarketPrice}"
                      DisplayMemberPath="Name" ToolTip="Price"/>
            <ComboBox Width="190" ItemsSource="{Binding MarketSorts}" SelectedItem="{Binding MarketSort}"
                      DisplayMemberPath="Name" ToolTip="Sort"/>
          </StackPanel>
        </Grid>

        <ctl:StateView State="{Binding MarketLoad.State}" Message="{Binding MarketLoad.Message}" MinHeight="260"
                       EmptyText="No items found. Try another category, price or search." RetryCommand="{Binding RefreshMarketCommand}">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding MarketItems}" ItemTemplate="{StaticResource MarketTile}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Button HorizontalAlignment="Center" Margin="0,8,0,0" Padding="22,10" Command="{Binding LoadMoreMarketCommand}"
                    Visibility="{Binding MarketHasMore, Converter={StaticResource BoolVis}}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Content" Value="Load more"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding MarketLoadingMore}" Value="True">
                      <Setter Property="Content" Value="Loading…"/>
                      <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </ctl:StateView>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= a limited: the item page shared with Trades ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsMarketLimitedOpen, Converter={StaticResource BoolVis}}">
      <local:ItemPageView Margin="32,22,32,32"/>
    </ScrollViewer>

    <!-- ================= one item ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsMarketPlainItemOpen, Converter={StaticResource BoolVis}}">
      <StackPanel Margin="32,22,32,32">
        <Button Style="{StaticResource Subtle}" HorizontalAlignment="Left" Command="{Binding CloseMarketItemCommand}" Margin="-8,0,0,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding MarketTitle, StringFormat='Back to {0}'}"/>
          </StackPanel>
        </Button>

        <ctl:StateView State="{Binding MarketItemLoad.State}" Message="{Binding MarketItemLoad.Message}" MinHeight="300"
                       RetryCommand="{Binding RetryOpenMarketCommand}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="340"/>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- picture: the item, or the account trying it on -->
            <StackPanel VerticalAlignment="Top">
              <Border Style="{StaticResource CardBox}" Padding="0" CornerRadius="22">
                <Grid>
                  <Viewbox Stretch="Uniform">
                    <Grid Width="420" Height="420">
                      <ctl:RemoteImage Url="{Binding MarketItemPicture}" CornerRadius="21"
                                       Visibility="{Binding IsTryingOn, Converter={StaticResource BoolVisInv}}"/>
                      <ctl:RemoteImage Url="{Binding TryOnPicture}" CornerRadius="21"
                                       Visibility="{Binding IsTryingOn, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                  </Viewbox>
                  <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="12,5" CornerRadius="10"
                          Background="{DynamicResource Card2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" IsHitTestVisible="False"
                          Visibility="{Binding TryOnBusy, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                      <ProgressBar IsIndeterminate="True" Width="40" Height="3" BorderThickness="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" Margin="0,0,8,0"/>
                      <TextBlock FontSize="11"><Run Text="Putting it on"/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay}"/><Run Text="…"/></TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Margin="4,10,0,0" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                         Visibility="{Binding IsTryingOn, Converter={StaticResource BoolVis}}">
                <Run Text="Trying it on"/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay}"/><Run Text=". Only a picture: nothing is bought or changed on the account."/>
              </TextBlock>
            </StackPanel>

            <!-- info and actions -->
            <StackPanel Grid.Column="2">
              <TextBlock Text="{Binding OpenMarketItem.Name}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource MutedText}"><Run Text="by"/> <Run Text="{Binding OpenMarketItem.CreatorName, Mode=OneWay}"
                           Foreground="{DynamicResource Fg}"/></TextBlock>
                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Blue}" ToolTip="Verified creator"
                           Visibility="{Binding OpenMarketItem.CreatorVerified, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
              <TextBlock Text="{Binding MarketItemMeta}" Margin="0,4,0,0" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>

              <!-- the numbers as cards, like a limited's page: they use the width next to the picture -->
              <UniformGrid Columns="3" Margin="0,18,-12,0">
                <Border Style="{StaticResource CardBox}" Padding="16,12" Margin="0,0,12,12" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Accent}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Type" FontSize="12" Foreground="{DynamicResource Accent}"/>
                      <TextBlock Text="{Binding OpenMarketItem.KindText}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource CardBox}" Padding="16,12" Margin="0,0,12,12" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Accent}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE734;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Favourites" FontSize="12" Foreground="{DynamicResource Accent}"/>
                      <TextBlock Text="{Binding OpenMarketItem.Favorites, StringFormat={}{0:N0}}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource CardBox}" Padding="16,12" Margin="0,0,12,12" BorderThickness="0,2,0,0" BorderBrush="{DynamicResource Accent}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Creator" FontSize="12" Foreground="{DynamicResource Accent}"/>
                      <TextBlock Text="{Binding OpenMarketItem.CreatorName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </UniformGrid>

              <Grid Margin="0,8,0,14" MaxWidth="560" HorizontalAlignment="Left" MinWidth="420">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding OpenMarketItem.PriceText}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding OpenMarketItem.PriceNote}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,4" CornerRadius="9"
                        Background="{DynamicResource Card2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                        Visibility="{Binding OpenMarketItem.IsOwned, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock FontSize="12"><Run Text="{Binding CurrentAccount.Label, Mode=OneWay}"/> <Run Text="owns this"/></TextBlock>
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel MaxWidth="560" HorizontalAlignment="Left" MinWidth="420">
              <Button Style="{StaticResource Primary}" HorizontalAlignment="Stretch" Padding="16,13" Margin="0,0,0,8"
                      Command="{Binding GetOrBuyCommand}" IsEnabled="{Binding CanGetOrBuy}">
                <TextBlock FontWeight="SemiBold" Text="{Binding BuyButtonText}"/>
              </Button>
              <UniformGrid Columns="2">
                <Button Margin="0,0,8,0" Command="{Binding TryOnCommand}" IsEnabled="{Binding HasCurrentAccount}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Setter Property="Content" Value="Try on"/>
                      <Setter Property="ToolTip" Value="See it on this account's avatar. Nothing is bought or changed."/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsTryingOn}" Value="True">
                          <Setter Property="Content" Value="Stop trying on"/>
                          <Setter Property="ToolTip" Value="Show the item again"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Grid>
                  <Button Content="Wear now" Margin="0" Command="{Binding WearMarketItemCommand}" ToolTip="Put it on this account's avatar"
                          Visibility="{Binding OpenMarketItem.IsOwned, Converter={StaticResource BoolVis}}"/>
                  <Button Content="Open on roblox.com" ctl:Btn.External="True" Margin="0" Command="{Binding OpenMarketOnWebCommand}"
                          Visibility="{Binding OpenMarketItem.IsOwned, Converter={StaticResource BoolVisInv}}"/>
                </Grid>
              </UniformGrid>

              <TextBlock Margin="2,12,0,0" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding MarketAsText}"/>
              </StackPanel>

              <!-- limiteds: everyone reselling a copy, cheapest first -->
              <StackPanel Margin="0,22,0,0" Visibility="{Binding ShowSellers, Converter={StaticResource BoolVis}}">
                <Grid Margin="0,0,0,8">
                  <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="Sellers"/> <Run Text="{Binding MarketSellers.Count, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource Muted}"/>
                  </TextBlock>
                  <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Refresh sellers" Margin="0" HorizontalAlignment="Right"
                          Command="{Binding ReloadSellersCommand}"/>
                </Grid>
                <Border Style="{StaticResource CardBox}" Padding="6"
                        Visibility="{Binding MarketSellers.Count, Converter={StaticResource CountVis}}">
                  <ItemsControl ItemsSource="{Binding MarketSellers}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="8,5">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Blue}" Visibility="{Binding Verified, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding SerialText}" Style="{StaticResource MutedText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="your account" Foreground="{DynamicResource Accent}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding IsYours, Converter={StaticResource BoolVis}}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding PriceText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,12,0"/>
                          <Button Grid.Column="2" Content="Buy" Margin="0" Padding="16,6" Focusable="False"
                                  IsEnabled="{Binding IsYours, Converter={StaticResource Not}}"
                                  Command="{Binding DataContext.BuyFromSellerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <TextBlock Text="Loading sellers…" Style="{StaticResource MutedText}" Margin="2,6,0,0"
                           Visibility="{Binding SellersLoading, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding SellersNote}" Style="{StaticResource MutedText}" Margin="2,6,0,0" TextWrapping="Wrap"
                           Visibility="{Binding SellersNote, Converter={StaticResource EmptyCollapsed}}"/>
                <Button Content="More sellers" ctl:Btn.Icon="&#xE70D;" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding LoadMoreSellersCommand}"
                        Visibility="{Binding SellersHasMore, Converter={StaticResource BoolVis}}"/>
              </StackPanel>

              <TextBlock Text="Includes" FontWeight="SemiBold" Margin="0,22,0,6"
                         Visibility="{Binding OpenMarketItem.Parts.Count, Converter={StaticResource CountVis}}"/>
              <ItemsControl ItemsSource="{Binding OpenMarketItem.Parts}"
                            Visibility="{Binding OpenMarketItem.Parts.Count, Converter={StaticResource CountVis}}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name, StringFormat='·  {0}'}" Margin="0,1" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,22,0,6"
                         Visibility="{Binding OpenMarketItem.Description, Converter={StaticResource EmptyCollapsed}}"/>
              <TextBlock Text="{Binding OpenMarketItem.Description}" TextWrapping="Wrap" LineHeight="20" Style="{StaticResource MutedText}"
                         Visibility="{Binding OpenMarketItem.Description, Converter={StaticResource EmptyCollapsed}}"/>
            </StackPanel>
          </Grid>
        </ctl:StateView>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= confirm before spending Robux ================= -->
    <Grid Visibility="{Binding ShowBuyConfirm, Converter={StaticResource BoolVis}}" Background="#B0000000">
      <Border Style="{StaticResource CardBox}" Width="440" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Card}">
        <StackPanel>
          <TextBlock Text="Buy this item?" FontSize="20" FontWeight="Bold"/>
          <Grid Margin="0,16,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="72" Height="72" CornerRadius="12" Background="{DynamicResource Card2}">
              <ctl:RemoteImage Url="{Binding OpenMarketItem.ThumbUrl}" CornerRadius="12"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding OpenMarketItem.Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding OpenMarketItem.KindText}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
            <TextBlock Text="Price" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding BuyPrice, StringFormat='R$ {0:N0}'}" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Account" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentAccount.Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2" Text="Robux" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BuyAfterText}" VerticalAlignment="Center" FontFamily="Consolas"/>
            <TextBlock Grid.Row="3" Text="Seller" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BuySellerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Grid>

          <TextBlock Text="This account doesn't have enough Robux." Foreground="{DynamicResource Red}" Margin="0,12,0,0" TextWrapping="Wrap"
                     Visibility="{Binding BuyNotEnough, Converter={StaticResource BoolVis}}"/>
          <TextBlock Foreground="{DynamicResource Red}" Margin="0,12,0,0" TextWrapping="Wrap"
                     Visibility="{Binding BuyOverLimit, Converter={StaticResource BoolVis}}">
            <Run Text="This is over your spending limit of"/> <Run Text="{Binding Settings.MarketSpendLimit, Mode=OneWay, StringFormat='R$ {0:N0}'}"/><Run Text=". You can change it in Settings → Marketplace &amp; trades."/>
          </TextBlock>
          <TextBlock Text="{Binding BuyError}" Foreground="{DynamicResource Red}" Margin="0,12,0,0" TextWrapping="Wrap"
                     Visibility="{Binding BuyError, Converter={StaticResource EmptyCollapsed}}"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelBuyCommand}" IsCancel="True"/>
            <Button Margin="0" Command="{Binding ConfirmBuyCommand}" IsEnabled="{Binding CanConfirmBuy}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                  <Setter Property="Content" Value="{Binding ConfirmBuyText}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BuyBusy}" Value="True">
                      <Setter Property="Content" Value="Buying…"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- buying a seller's copy of a limited -->
    <local:BuyCardView/>
  </Grid>
</UserControl>
