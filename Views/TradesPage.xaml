<UserControl x:Class="RoDeck.Views.TradesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls"
             xmlns:local="clr-namespace:RoDeck.Views">
  <UserControl.Resources>

    <!-- a difference pill: green when it's in your favour, red when not -->
    <Style x:Key="DiffPill" TargetType="Border">
      <Setter Property="Padding" Value="10,3"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Margin" Value="4,0"/>
      <Setter Property="Background" Value="{DynamicResource Card2}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="1"><Setter Property="Background" Value="{DynamicResource GreenBg}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="-1"><Setter Property="Background" Value="{DynamicResource RedBg}"/></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- a trade item: picture with serial, name, value (orange) and RAP (blue) -->
    <DataTemplate x:Key="TradeItemCard">
      <StackPanel Width="118" Margin="0,0,12,12" Background="Transparent" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
        <StackPanel.ToolTip><ctl:RapTip/></StackPanel.ToolTip>
        <Grid>
          <Border Height="118" CornerRadius="10" Background="{DynamicResource Card2}"/>
          <ctl:RemoteImage Url="{Binding ThumbUrl}" Height="118" CornerRadius="10"/>
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" Padding="6,1" CornerRadius="6" Background="#C0000000"
                  Visibility="{Binding SerialText, Converter={StaticResource EmptyCollapsed}}">
            <TextBlock Text="{Binding SerialText}" FontSize="10" Foreground="White"/>
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,1" CornerRadius="6" Background="#C0000000"
                  Visibility="{Binding IsOnHold, Converter={StaticResource BoolVis}}">
            <TextBlock Text="On hold" FontSize="10" Foreground="White"/>
          </Border>
          <!-- its owner doesn't have it anymore -->
          <Border CornerRadius="10" Background="#99000000" BorderBrush="{DynamicResource Red}" BorderThickness="2"
                  Visibility="{Binding IsGone, Converter={StaticResource BoolVis}}" ToolTip="Not in their inventory anymore">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" CornerRadius="7" Background="{DynamicResource Red}">
              <TextBlock Text="Gone" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
            </Border>
          </Border>
        </Grid>
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,2" TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBlock Text="{Binding WorthNumber}" FontSize="12"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
          <TextBlock Text="{Binding RapNumber}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <!-- a limited as a small card: picture, name, value / RAP, serial; accent border when picked -->
    <DataTemplate x:Key="LimitedCard">
      <Border x:Name="b" Width="140" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="12"
              ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000">
        <Border.ToolTip><ctl:RapTip/></Border.ToolTip>
        <StackPanel>
          <Grid>
            <Border Height="118" CornerRadius="11,11,0,0" Background="{DynamicResource Card2}"/>
            <ctl:RemoteImage Url="{Binding ThumbUrl}" Height="118" CornerRadius="11" TopCornersOnly="True"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="6,1" CornerRadius="6" Background="#C0000000"
                    Visibility="{Binding SerialText, Converter={StaticResource EmptyCollapsed}}">
              <TextBlock Text="{Binding SerialText}" FontSize="10" Foreground="White"/>
            </Border>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,1" CornerRadius="6" Background="#C0000000"
                    Visibility="{Binding IsOnHold, Converter={StaticResource BoolVis}}">
              <TextBlock Text="On hold" FontSize="10" Foreground="White"/>
            </Border>
          </Grid>
          <StackPanel Margin="9,7,9,9">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding ValueText}" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="{Binding RapText}" FontSize="11" Style="{StaticResource MutedText}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter TargetName="b" Property="BorderThickness" Value="2"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- a plain clickable wrapper (the card has its own look) -->
    <Style x:Key="CardButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="g" Background="Transparent">
              <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
              <ContentPresenter/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.14">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.EnterActions>
                  <Trigger.ExitActions>
                    <BeginStoryboard>
                      <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="g" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.18">
                          <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                      </Storyboard>
                    </BeginStoryboard>
                  </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- a request tag (Any, Upgrade…): RoDeck's own tile, its colour with a soft shine, a big icon and a bold name -->
    <DataTemplate x:Key="AdTagTile">
      <!-- the app's own card look: dark card, the tag's colour as a soft glow behind a coloured icon, a coloured bar -->
      <Grid Width="104" Height="104">
        <Border CornerRadius="14" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"/>
        <Border CornerRadius="14" Background="{Binding Top, Converter={StaticResource HexGlow}, ConverterParameter=85}"/>
        <Border Width="46" Height="46" CornerRadius="23" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                Background="{Binding Top, Converter={StaticResource HexGlow}, ConverterParameter=60}"
                BorderBrush="{Binding Top, Converter={StaticResource HexBrush}}" BorderThickness="1.5">
          <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="20"
                     Foreground="{Binding Top, Converter={StaticResource HexBrush}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="{Binding Upper}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Center"
                   VerticalAlignment="Bottom" Margin="0,0,0,17"/>
        <Border Width="26" Height="3" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9"
                Background="{Binding Top, Converter={StaticResource HexBrush}}"/>
      </Grid>
    </DataTemplate>

    <!-- one of the ad's slots: dashed and empty ("Offer" / "Want"), an item card, or a tag tile -->
    <DataTemplate x:Key="AdSlotTile">
      <Button Style="{StaticResource CardButton}" Margin="0,0,10,10" ToolTip="Empty: click to choose what goes here. Filled: click to empty it."
              Command="{Binding DataContext.OpenAdSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
        <Grid Width="104" Height="104">
          <Border CornerRadius="14" BorderThickness="1.5" Background="{DynamicResource Card}"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
            <Border.BorderBrush>
              <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                  <GeometryDrawing Brush="#55FFFFFF">
                    <GeometryDrawing.Geometry>
                      <GeometryGroup><RectangleGeometry Rect="0,0,4,4"/><RectangleGeometry Rect="4,4,4,4"/></GeometryGroup>
                    </GeometryDrawing.Geometry>
                  </GeometryDrawing>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Border.BorderBrush>
            <TextBlock Text="{Binding EmptyText}" FontStyle="Italic" FontWeight="SemiBold" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border CornerRadius="14" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"
                  Visibility="{Binding HasItem, Converter={StaticResource BoolVis}}">
            <Grid>
              <ctl:RemoteImage Url="{Binding Item.ThumbUrl}" Margin="8,6,8,26" CornerRadius="8" Background="Transparent" Stretch="Uniform"/>
              <TextBlock Text="{Binding Item.WorthNumber}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,8" Foreground="{DynamicResource Accent}" ToolTip="{Binding Item.Name}"/>
            </Grid>
          </Border>
          <ContentControl Content="{Binding Tag}" ContentTemplate="{StaticResource AdTagTile}"
                          Visibility="{Binding HasTag, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- a calculator slot: like a trade ad slot, items only -->
    <DataTemplate x:Key="CalcSlotTile">
      <Button Style="{StaticResource CardButton}" Margin="0,0,10,10" ToolTip="Empty: click to pick an item. Filled: click to take it out."
              Click="CalcSlot_Click" Command="{Binding DataContext.OpenCalcSlotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
        <Grid Width="104" Height="104">
          <Border CornerRadius="14" BorderThickness="1.5" Background="{DynamicResource Card}"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
            <Border.BorderBrush>
              <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                <DrawingBrush.Drawing>
                  <GeometryDrawing Brush="#55FFFFFF">
                    <GeometryDrawing.Geometry>
                      <GeometryGroup><RectangleGeometry Rect="0,0,4,4"/><RectangleGeometry Rect="4,4,4,4"/></GeometryGroup>
                    </GeometryDrawing.Geometry>
                  </GeometryDrawing>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Border.BorderBrush>
            <TextBlock Text="{Binding EmptyText}" FontStyle="Italic" FontWeight="SemiBold" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border CornerRadius="14" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1"
                  Visibility="{Binding HasItem, Converter={StaticResource BoolVis}}">
            <Grid>
              <ctl:RemoteImage Url="{Binding Item.ThumbUrl}" Margin="8,6,8,26" CornerRadius="8" Background="Transparent" Stretch="Uniform"/>
              <TextBlock Text="{Binding Item.WorthNumber}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                         Margin="0,0,0,8" Foreground="{DynamicResource Accent}" ToolTip="{Binding Item.Name}"/>
            </Grid>
          </Border>
        </Grid>
      </Button>
    </DataTemplate>


    <!-- win / loss colouring for an int: 1 green, -1 red -->
    <Style x:Key="VerdictText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="1"><Setter Property="Foreground" Value="{DynamicResource Green}"/></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="-1"><Setter Property="Foreground" Value="{DynamicResource Red}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- a limited as one compact line (search results in the calculator and watchlist) -->
    <DataTemplate x:Key="LimitedLine">
      <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,0,6">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Width="40" Height="40">
            <Border CornerRadius="8" Background="{DynamicResource Card2}"/>
            <ctl:RemoteImage Url="{Binding ThumbUrl}" CornerRadius="8"/>
          </Grid>
          <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock Text="{Binding WorthNumber}" FontSize="11"/>
              <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="10,0,4,0"/>
              <TextBlock Text="{Binding RapNumber}" FontSize="11"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"
                     Foreground="{DynamicResource Accent}"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- one side of the calculator: its items (click one to take it off), Robux, totals -->
    <Style x:Key="CalcSideCard" TargetType="Border" BasedOn="{StaticResource CardBox}">
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <!-- a picker over the tab: a raised card with a soft shadow and an accent edge (no dimming behind it) -->
    <Style x:Key="PickerCard" TargetType="Border" BasedOn="{StaticResource CardBox}">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="20,0,20,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="MaxWidth" Value="900"/>
      <Setter Property="Effect">
        <Setter.Value><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.55" Color="Black"/></Setter.Value>
      </Setter>
    </Style>
    <!-- a number box with its name inside, top left (Min value / Max value) -->
    <Style x:Key="RangeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="10,17,10,3"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="RangeLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="12,7,0,0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <!-- the Limiteds table: a header you can click to sort, and a quick-filter chip -->
    <Style x:Key="TableHeadText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TableHead" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent" Padding="0,4"><ContentPresenter VerticalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- the clickable part of a deal row: a soft highlight on hover -->
    <Style x:Key="DealLink" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="-6,-4,6,-4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="10"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FilterChip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,26,32,32">
        <Grid>
          <TextBlock Text="Trades" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding ValuesNote}" VerticalAlignment="Center" FontSize="12" Style="{StaticResource MutedText}" Margin="0,0,14,0"/>
            <Button Margin="0" Padding="12,7" Command="{Binding OpenMyTradeProfileCommand}" ToolTip="Your limiteds and what they're worth">
              <StackPanel Orientation="Horizontal">
                <ctl:AvatarView Width="20" Height="20" Url="{Binding CurrentAccount.AvatarUrl}" Initials="{Binding CurrentAccount.Initials}" Margin="0,0,8,0"/>
                <TextBlock Text="My inventory" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,18">
          <RadioButton Style="{StaticResource Seg}" Content="Deals" GroupName="tradestab"
                       IsChecked="{Binding TradesTab, Converter={StaticResource Eq}, ConverterParameter=Deals, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Seg}" Content="Limiteds" GroupName="tradestab"
                       IsChecked="{Binding TradesTab, Converter={StaticResource Eq}, ConverterParameter=Limiteds, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Seg}" Content="Calculator" GroupName="tradestab"
                       IsChecked="{Binding TradesTab, Converter={StaticResource Eq}, ConverterParameter=Calculator, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Seg}" GroupName="tradestab"
                       IsChecked="{Binding TradesTab, Converter={StaticResource Eq}, ConverterParameter=Watchlist, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Watchlist" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Visibility="{Binding WatchRows.Count, Converter={StaticResource CountVis}}">
                <TextBlock Text="{Binding WatchRows.Count}" Style="{StaticResource BadgeText}"/>
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Content="Inventory value" GroupName="tradestab"
                       IsChecked="{Binding TradesTab, Converter={StaticResource Eq}, ConverterParameter=Inventory, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Seg}" GroupName="tradestab"
                       IsChecked="{Binding TradesTab, Converter={StaticResource Eq}, ConverterParameter=Trades, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="My trades" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource Accent}"
                      Visibility="{Binding InboundCount, Converter={StaticResource CountVis}}">
                <TextBlock Text="{Binding InboundCount}" Style="{StaticResource BadgeText}" Foreground="{DynamicResource AccentFg}"/>
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" GroupName="tradestab" Margin="0"
                       IsChecked="{Binding TradesTab, Converter={StaticResource Eq}, ConverterParameter=Ads, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Trade ads" VerticalAlignment="Center"/>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Green}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="Posting"
                       Visibility="{Binding AdRunning, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <!-- ================= CALCULATOR ================= -->
        <Grid x:Name="CalcTab" Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Calculator}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- 4 slots per side, like a trade ad -->
          <Border Style="{StaticResource CardBox}" Padding="22,18" VerticalAlignment="Top">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="YOU GIVE" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Border Padding="10,3" CornerRadius="9" Background="{DynamicResource AccentSoft}" ToolTip="Value" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding CalcGiveValue}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                  </Border>
                  <Border Padding="10,3" CornerRadius="9" Background="{DynamicResource Card2}" ToolTip="RAP">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding CalcGiveRap}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding CalcGiveSlots}" ItemTemplate="{StaticResource CalcSlotTile}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="+ Robux" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                <TextBox Text="{Binding CalcGiveRobux, UpdateSourceTrigger=PropertyChanged}" Width="110" Style="{StaticResource NumBoxSmall}"/>
              </StackPanel>

              <!-- the result -->
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,16,0,14"/>
              <Grid>
                <StackPanel>
                  <TextBlock Text="{Binding CalcVerdict}" FontSize="14" FontWeight="SemiBold" Tag="{Binding CalcVerdictKind}" Style="{StaticResource VerdictText}"
                             TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left"/>
                  <StackPanel Orientation="Horizontal" Margin="-4,8,0,0">
                    <Border Style="{StaticResource DiffPill}" Tag="{Binding CalcValueDiffKind}" ToolTip="Value difference">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CalcValueDiff}" FontSize="12" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DiffPill}" Tag="{Binding CalcRapDiffKind}" ToolTip="RAP difference">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CalcRapDiff}" FontSize="12" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Style="{StaticResource IconBtn}" Content="&#xE8AB;" ToolTip="Swap the sides" Command="{Binding CalcSwapCommand}"/>
                  <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Clear both sides" Margin="0" Command="{Binding CalcClearCommand}"/>
                </StackPanel>
              </Grid>
              <Border Height="1" Background="{DynamicResource Line}" Margin="0,14,0,14"/>

              <Grid Margin="0,0,0,10">
                <TextBlock Text="YOU GET" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Border Padding="10,3" CornerRadius="9" Background="{DynamicResource AccentSoft}" ToolTip="Value" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding CalcGetValue}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                  </Border>
                  <Border Padding="10,3" CornerRadius="9" Background="{DynamicResource Card2}" ToolTip="RAP">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding CalcGetRap}" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding CalcGetSlots}" ItemTemplate="{StaticResource CalcSlotTile}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="+ Robux" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                <TextBox Text="{Binding CalcGetRobux, UpdateSourceTrigger=PropertyChanged}" Width="110" Style="{StaticResource NumBoxSmall}" ToolTip="Counts after Roblox's 30% fee, as in a real trade"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="20,16" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="How it works" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <TextBlock TextWrapping="Wrap" FontSize="12" Style="{StaticResource MutedText}" LineHeight="19"
                         Text="Click an empty slot to pick an item, click a filled slot to take it out. You give starts on your own inventory, You get on every limited; both can switch. Values come from Rolimons (RAP when an item has no value). Robux you get count after Roblox's 30% fee."/>
            </StackPanel>
          </Border>

          <!-- the picker, over the tab -->
          <Grid Grid.ColumnSpan="3" Visibility="{Binding IsCalcPickerOpen, Converter={StaticResource BoolVis}}">
            <Border x:Name="CalcPickerCard" Style="{StaticResource PickerCard}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="{Binding CalcPickerTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                  <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Margin="0" HorizontalAlignment="Right" ToolTip="Close" Command="{Binding CloseCalcPickerCommand}"/>
                </Grid>
                <!-- where the items come from -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <RadioButton Style="{StaticResource Seg}" GroupName="calcsource"
                               IsChecked="{Binding CalcPickerSource, Converter={StaticResource Eq}, ConverterParameter=Inventory, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="Your inventory"/>
                    </StackPanel>
                  </RadioButton>
                  <RadioButton Style="{StaticResource Seg}" GroupName="calcsource" Margin="0"
                               IsChecked="{Binding CalcPickerSource, Converter={StaticResource Eq}, ConverterParameter=Browse, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <TextBlock Text="Browse items"/>
                    </StackPanel>
                  </RadioButton>
                </StackPanel>

                <!-- search, sort, value range: one row, all the same height -->
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ctl:SearchBox Text="{Binding CalcPickerSearch, UpdateSourceTrigger=PropertyChanged}" Placeholder="Filter by name, acronym or ID" Margin="0,0,10,0"/>
                  <Button Grid.Column="1" Margin="0,0,10,0" Padding="14,0" Command="{Binding ToggleCalcPickerSortCommand}" ToolTip="Sort by value">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Accent}"/>
                      <TextBlock Text="{Binding CalcPickerSortText}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Grid Grid.Column="2" Width="96" Margin="0,0,8,0">
                    <TextBox Text="{Binding CalcPickerMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RangeBox}"/>
                    <TextBlock Text="Min value" Style="{StaticResource RangeLabel}"/>
                  </Grid>
                  <Grid Grid.Column="3" Width="96">
                    <TextBox Text="{Binding CalcPickerMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RangeBox}"/>
                    <TextBlock Text="Max value" Style="{StaticResource RangeLabel}"/>
                  </Grid>
                </Grid>

                <!-- your inventory still loading -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding CalcPickerIsInventory}" Value="True"/>
                            <Condition Binding="{Binding CalcInventoryLoad.State}" Value="Loading"/>
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>
                  <ProgressBar IsIndeterminate="True" Width="120" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock Text="{Binding CalcInventoryLoad.Message}" FontSize="12" Style="{StaticResource MutedText}"/>
                </StackPanel>

                <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding CalcPickerItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0,0,10,10" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                                Command="{Binding DataContext.PickCalcItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Nothing matches." Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Visibility="{Binding CalcPickerItems.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ================= WATCHLIST ================= -->
        <StackPanel Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Watchlist}">
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <ctl:SearchBox Text="{Binding WatchSearch, UpdateSourceTrigger=PropertyChanged}" Placeholder="Add a limited: type its name"/>
              <ItemsControl ItemsSource="{Binding WatchHits}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource CardButton}" Margin="0" HorizontalContentAlignment="Stretch" Content="{Binding}" ContentTemplate="{StaticResource LimitedLine}"
                            Command="{Binding DataContext.WatchAddCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding WatchStatus}" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       Margin="20,10,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" TextAlignment="Right"/>
          </Grid>

          <Border Style="{StaticResource CardBox}" Padding="28,26" Visibility="{Binding HasWatchRows, Converter={StaticResource BoolVisInv}}">
            <StackPanel>
              <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="Watch a limited's price" FontSize="18" FontWeight="Bold" Margin="0,10,0,6"/>
              <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}"
                         Text="Add limiteds you'd like to buy and set your price, or a deal in % under the value. RoDeck checks new listings every second, also while it's in the tray, and sends a Windows notification as soon as one is at or below your price."/>
            </StackPanel>
          </Border>

          <ItemsControl ItemsSource="{Binding WatchRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="b" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1" CornerRadius="14"
                        Padding="12,10,16,10" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="230"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56">
                      <Border CornerRadius="10" Background="{DynamicResource Card2}"/>
                      <ctl:RemoteImage Url="{Binding ThumbUrl}" CornerRadius="10"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding ValueText}" FontSize="12" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="12,0,5,0"/>
                        <TextBlock Text="{Binding RapText}" FontSize="12" Style="{StaticResource MutedText}"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock Text="Cheapest now" FontSize="11" Style="{StaticResource MutedText}"/>
                      <TextBlock Text="{Binding BestText}" FontSize="16" FontWeight="Bold" Margin="0,1,0,0"/>
                    </StackPanel>
                    <!-- a price, or a deal in % under the value (the price then follows the value) -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <TextBlock Text="Your price (at most)  or  deal" FontSize="11" Style="{StaticResource MutedText}" Margin="0,0,0,3"/>
                      <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding PriceInput, UpdateSourceTrigger=LostFocus}" Width="110" Style="{StaticResource NumBoxSmall}"
                                 ToolTip="A fixed price in Robux" KeyDown="WatchBox_KeyDown"/>
                        <Grid Margin="8,0,0,0" ToolTip="How far under its value (RAP without one). The price follows the value when it changes.">
                          <TextBox Text="{Binding PercentInput, UpdateSourceTrigger=LostFocus}" Width="96" Style="{StaticResource NumBoxSmall}" Padding="6,8,46,8"
                                   KeyDown="WatchBox_KeyDown"/>
                          <TextBlock Text="% off" FontSize="12" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                     Margin="0,0,10,0" IsHitTestVisible="False"/>
                        </Grid>
                      </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="4" Style="{StaticResource DiffPill}" Tag="{Binding Kind}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0">
                      <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="View" Padding="14,7"
                              Command="{Binding DataContext.WatchOpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                              ToolTip="Its sellers on the Marketplace"/>
                      <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Margin="0" ToolTip="Stop watching"
                              Command="{Binding DataContext.WatchRemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsHit}" Value="True">
                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Green}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ================= A TRADE PROFILE ================= -->
        <StackPanel Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Profile}">
          <Button Style="{StaticResource Subtle}" HorizontalAlignment="Left" Command="{Binding CloseTradeProfileCommand}" Margin="-8,0,0,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding TradeProfileBackText}"/>
            </StackPanel>
          </Button>

          <Border Style="{StaticResource CardBox}" Padding="22,20">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid Width="80" Height="80">
                <Ellipse Fill="{DynamicResource AccentSoft}" Stroke="{DynamicResource Accent}" StrokeThickness="2"/>
                <ctl:AvatarView Width="72" Height="72" Url="{Binding TradeProfileHead}"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding TradeProfileName}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                  <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Margin="10,0,0,0" Height="20"
                          Visibility="{Binding TradeProfileIsMe, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="You" Style="{StaticResource BadgeText}" Foreground="{DynamicResource Accent}"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding TradeProfileUser, StringFormat='@{0}'}" Style="{StaticResource MutedText}" Margin="0,2,0,12"
                           Visibility="{Binding TradeProfileUser, Converter={StaticResource EmptyCollapsed}}"/>
                <StackPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="Value" FontSize="11" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding TradeProfileValue}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Margin="0,0,28,0">
                    <TextBlock Text="RAP" FontSize="11" Style="{StaticResource MutedText}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding TradeProfileRap}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="Limiteds" FontSize="11" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding TradeProfileCount}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button Style="{StaticResource Primary}" Margin="0,0,0,8" Padding="18,9" Command="{Binding TradeWithProfileCommand}"
                        Visibility="{Binding TradeProfileIsMe, Converter={StaticResource BoolVisInv}}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Trade with them"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Roblox" ctl:Btn.External="True" Padding="14,7" Command="{Binding OpenProfileOnRobloxCommand}" ToolTip="Their profile on roblox.com"/>
                  <Button Content="Rolimons" ctl:Btn.External="True" Padding="14,7" Margin="0" Command="{Binding OpenProfileOnRolimonsCommand}" ToolTip="Their page on rolimons.com"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <!-- their limiteds: they appear one by one as they come in -->
          <Grid Margin="2,22,0,12">
            <TextBlock FontSize="18" FontWeight="Bold">
              <Run Text="Limiteds"/><Run Text="{Binding TradeProfileItems.Count, Mode=OneWay, StringFormat=' · {0}'}"/>
            </TextBlock>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="2,0,0,12" Visibility="{Binding TradeProfileLoading, Converter={StaticResource BoolVis}}">
            <ProgressBar IsIndeterminate="True" Width="160" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}"
                         VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding TradeProfileLoadingText}" FontSize="12" Style="{StaticResource MutedText}"/>
          </StackPanel>
          <TextBlock Text="{Binding TradeProfileNote}" Style="{StaticResource MutedText}" Margin="2,0,0,12"
                     Visibility="{Binding TradeProfileNote, Converter={StaticResource EmptyCollapsed}}"/>
          <ItemsControl ItemsSource="{Binding TradeProfileItems}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource CardButton}" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                        Command="{Binding DataContext.OpenLimitedFromInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                  <!-- each one fades in as it arrives -->
                  <Button.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Button.Triggers>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- ================= TRADE ADS ================= -->
        <Grid Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Ads}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- the ad: 4 offer slots, 4 want slots -->
          <Border Style="{StaticResource CardBox}" Padding="22,18" VerticalAlignment="Top">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock Text="YOU OFFER" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" Padding="10,3" CornerRadius="9" Background="{DynamicResource AccentSoft}" ToolTip="Value of what you offer">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding AdOfferValue}" FontWeight="Bold" FontSize="12"/>
                  </StackPanel>
                </Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding AdOfferSlots}" ItemTemplate="{StaticResource AdSlotTile}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>

              <Grid Margin="0,10,0,10">
                <TextBlock Text="YOU WANT" FontSize="12" FontWeight="Bold" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <Border HorizontalAlignment="Right" Padding="10,3" CornerRadius="9" Background="{DynamicResource AccentSoft}" ToolTip="Value of the items you ask for">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding AdWantValue}" FontWeight="Bold" FontSize="12"/>
                  </StackPanel>
                </Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding AdWantSlots}" ItemTemplate="{StaticResource AdSlotTile}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource Line}" Margin="0,8,0,14"/>
              <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Every" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                  <TextBox Text="{Binding Settings.TradeAdMinutes}" Width="56" Style="{StaticResource NumBox}"/>
                  <TextBlock Text="min" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Post now" ctl:Btn.Icon="&#xE724;" Command="{Binding PostAdNowCommand}" IsEnabled="{Binding CanStartAd}"/>
                  <Button Content="Start" ctl:Btn.Icon="&#xE768;" Style="{StaticResource Primary}" Margin="0" Padding="22,9" Command="{Binding StartAdCommand}"
                          IsEnabled="{Binding CanStartAd}" Visibility="{Binding AdRunning, Converter={StaticResource BoolVisInv}}"/>
                  <Button Content="Stop" ctl:Btn.Icon="&#xE71A;" Margin="0" Padding="22,9" Command="{Binding StopAdCommand}"
                          Visibility="{Binding AdRunning, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0" MaxWidth="450" HorizontalAlignment="Left">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AdRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource Green}"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding AdStatus}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="{Binding AdLastResult, StringFormat='Last answer from Rolimons: {0}'}" FontSize="11" Style="{StaticResource MutedText}"
                         Margin="15,4,0,0" TextWrapping="Wrap" MaxWidth="450" HorizontalAlignment="Left"
                         Visibility="{Binding AdLastResult, Converter={StaticResource EmptyCollapsed}}"/>
            </StackPanel>
          </Border>

          <!-- how it works + verification -->
          <StackPanel Grid.Column="2">
            <Border Style="{StaticResource CardBox}" Padding="20,16" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="Rolimons verification" FontWeight="SemiBold"/>
                <StackPanel Visibility="{Binding HasRoliCookie, Converter={StaticResource BoolVisInv}}">
                  <TextBlock TextWrapping="Wrap" FontSize="12" Style="{StaticResource MutedText}" Margin="0,4,0,10"
                             Text="Rolimons needs proof the account is yours. Verify it on rolimons.com, then in your browser press F12 → Application → Cookies → rolimons.com, and copy the value of _RoliVerification here."/>
                  <Grid>
                    <TextBox Text="{Binding RoliCookieInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,0,100,0"/>
                    <Button Content="Save" ctl:Btn.Icon="&#xE74E;" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0" Padding="22,9" Command="{Binding SaveRoliCookieCommand}"/>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="Kept encrypted on this PC and only sent to Rolimons." FontSize="11" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                <Grid Margin="0,6,0,0" Visibility="{Binding HasRoliCookie, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Green}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Saved, encrypted on this PC" FontSize="12" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Content="Forget" ctl:Btn.Icon="&#xE74D;" HorizontalAlignment="Right" Margin="0" Command="{Binding ForgetRoliCookieCommand}"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Padding="20,16">
              <StackPanel>
                <TextBlock Text="How it works" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Style="{StaticResource MutedText}" LineHeight="19"
                           Text="Click an empty slot to fill it, click a filled slot to empty it. Offer slots take your own limiteds, Want slots take any limited or a tag like Upgrade or Any (up to 4 each). Start posts the ad on Rolimons right away and again every 15 minutes or more while RoDeck runs, also from the tray. Rolimons allows one ad per account every 15 minutes."/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- the picker, over the tab -->
          <Grid Grid.ColumnSpan="3" Visibility="{Binding IsAdPickerOpen, Converter={StaticResource BoolVis}}">
            <Border x:Name="AdPickerCard" Style="{StaticResource PickerCard}">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <TextBlock Text="{Binding AdPickerTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Empty this slot" Command="{Binding ClearAdSlotCommand}"
                            Visibility="{Binding AdPickerSlot.IsEmpty, Converter={StaticResource BoolVisInv}, FallbackValue=Collapsed}"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE711;" Margin="0" ToolTip="Close" Command="{Binding CloseAdPickerCommand}"/>
                  </StackPanel>
                </Grid>

                <!-- tags (want slots only) -->
                <StackPanel Visibility="{Binding AdPickerShowsTags, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="TAGS" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                  <ItemsControl ItemsSource="{Binding AdTags}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0,0,8,8" Content="{Binding}" ContentTemplate="{StaticResource AdTagTile}"
                                Command="{Binding DataContext.PickAdTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="ITEMS" FontSize="11" FontWeight="Bold" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>
                </StackPanel>

                <!-- search, sort, value range: one row, all the same height -->
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ctl:SearchBox Text="{Binding AdPickerSearch, UpdateSourceTrigger=PropertyChanged}" Placeholder="Filter by name or acronym" Margin="0,0,10,0"/>
                  <Button Grid.Column="1" Margin="0,0,10,0" Padding="14,0" Command="{Binding ToggleAdPickerSortCommand}" ToolTip="Sort by value">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Accent}"/>
                      <TextBlock Text="{Binding AdPickerSortText}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Grid Grid.Column="2" Width="96" Margin="0,0,8,0">
                    <TextBox Text="{Binding AdPickerMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RangeBox}"/>
                    <TextBlock Text="Min value" Style="{StaticResource RangeLabel}"/>
                  </Grid>
                  <Grid Grid.Column="3" Width="96">
                    <TextBox Text="{Binding AdPickerMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RangeBox}"/>
                    <TextBlock Text="Max value" Style="{StaticResource RangeLabel}"/>
                  </Grid>
                </Grid>

                <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding AdPickerItems}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0,0,10,10" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                                Command="{Binding DataContext.PickAdItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="Nothing matches." Style="{StaticResource MutedText}" Margin="0,4,0,0"
                           Visibility="{Binding AdPickerItems.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ================= DEALS ================= -->
        <StackPanel Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Deals}">
          <Grid Margin="0,0,0,6">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
              <ComboBox Width="190" Margin="0,0,10,10" ItemsSource="{Binding DealThresholds}" SelectedItem="{Binding DealThreshold}" DisplayMemberPath="Name"
                        ToolTip="How far below its RAP (or value, see Deal on) a listing must be"/>
              <ComboBox Width="170" Margin="0,0,20,10" ItemsSource="{Binding DealSorts}" SelectedItem="{Binding DealSort}" DisplayMemberPath="Name"
                        ToolTip="Sort"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,20,10" VerticalAlignment="Center"
                          ToolTip="What a deal is measured against. Value uses RAP for items without a value.">
                <TextBlock Text="Deal on" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                <RadioButton Style="{StaticResource Seg}" Content="RAP" GroupName="dealbasis"
                             IsChecked="{Binding DealBasis, Converter={StaticResource Eq}, ConverterParameter=RAP, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource Seg}" Content="Value" GroupName="dealbasis" Margin="0"
                             IsChecked="{Binding DealBasis, Converter={StaticResource Eq}, ConverterParameter=Value, Mode=TwoWay}"/>
              </StackPanel>
              <CheckBox Content="Hide projected" IsChecked="{Binding DealsHideProjected}" Margin="0,0,20,10" VerticalAlignment="Center"
                        ToolTip="Projected items have a pushed-up RAP, so they look cheaper than they are"/>
              <CheckBox Content="Items with a value only" IsChecked="{Binding DealsValueOnly}" Margin="0,0,20,10" VerticalAlignment="Center"/>
              <CheckBox IsChecked="{Binding DealsAffordable}" Margin="0,0,20,10" VerticalAlignment="Center">
                <TextBlock><Run Text="What"/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue='I'}"/> <Run Text="can afford"/></TextBlock>
              </CheckBox>
            </WrapPanel>
          </Grid>
          <!-- insta-buy: red, and it asks every time it's switched on -->
          <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,12" BorderThickness="1">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Card}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DealInstaBuy}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RedBg}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Red}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Insta-buy" FontWeight="SemiBold" Foreground="{DynamicResource Red}"/>
                <TextBlock FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Buy purchases the cheapest copy straight away, without a confirm card. Only at the deal's price or less, and never over your spending limit. At your own risk."/>
              </StackPanel>
              <ToggleButton Grid.Column="2" Style="{StaticResource DangerSwitch}" IsChecked="{Binding DealInstaBuy}" VerticalAlignment="Center" Margin="16,0,0,0"
                            ToolTip="Insta-buy"/>
            </Grid>
          </Border>
          <TextBlock Text="{Binding DealsStatus}" FontSize="12" Style="{StaticResource MutedText}" Margin="2,0,0,4"/>
          <TextBlock FontSize="12" Style="{StaticResource MutedText}" Margin="2,0,0,14" TextWrapping="Wrap"
                     Text="Every limited's cheapest price, compared with its RAP or its value (pick with Deal on; Value uses RAP when an item has none). New listings come in live, and every limited is checked again every few minutes. Buy shows the cheapest copy's real price on a confirm card first: a deal can be sold to someone else in seconds. Click an item for its page."/>

          <Border Style="{StaticResource CardBox}" Padding="6" Visibility="{Binding Deals.Count, Converter={StaticResource CountVis}}">
            <ItemsControl ItemsSource="{Binding Deals}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="90"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- picture, name and prices: the item page -->
                    <Button Grid.ColumnSpan="3" Style="{StaticResource DealLink}" Focusable="False" ToolTip="Open the item page"
                            Command="{Binding DataContext.ViewDealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                    <Border Width="52" Height="52" CornerRadius="10" Background="{DynamicResource Card2}" IsHitTestVisible="False">
                      <ctl:RemoteImage Url="{Binding ThumbUrl}" CornerRadius="10"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                        <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Visibility="{Binding Projected, Converter={StaticResource BoolVis}}" ToolTip="RAP was pushed up: compare with care">
                          <TextBlock Text="Projected" FontSize="10" Style="{StaticResource MutedText}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding DetailText}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0" IsHitTestVisible="False">
                      <TextBlock Text="{Binding PriceText}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right"/>
                      <TextBlock Text="{Binding WorthText}" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                      <Border Padding="8,3" CornerRadius="8" HorizontalAlignment="Left" Background="{DynamicResource Card2}">
                        <TextBlock Text="{Binding DiscountText}" FontWeight="Bold" Foreground="{DynamicResource Green}"/>
                      </Border>
                      <TextBlock Text="{Binding AgoText}" FontSize="11" Style="{StaticResource MutedText}" Margin="2,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="View" Padding="14,8" Focusable="False" ToolTip="Open the item page"
                              Command="{Binding DataContext.ViewDealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="Buy" Margin="0" Padding="18,8" Focusable="False"
                              Command="{Binding DataContext.BuyDealCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                            <Setter Property="ToolTip" Value="Shows the cheapest copy's real price first"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DataContext.DealInstaBuy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Red}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="ToolTip" Value="Insta-buy: buys the cheapest copy now, no confirm card"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Border Style="{StaticResource CardBox}" Padding="24,30"
                  Visibility="{Binding Deals.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}">
            <StackPanel HorizontalAlignment="Center">
              <ProgressBar IsIndeterminate="True" Width="80" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}"
                           Background="{DynamicResource Line}" Margin="0,0,0,12"/>
              <TextBlock Text="No deals that match yet. They show up here as they're listed, keep this open." Style="{StaticResource MutedText}"
                         HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================= LIMITEDS ================= -->
        <Grid Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Limiteds}">
          <!-- the list: a table like Rolimons' item list -->
          <StackPanel Visibility="{Binding IsLimitedOpen, Converter={StaticResource BoolVisInv}}">
            <!-- search, quick filters -->
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ctl:SearchBox Text="{Binding LimitedsSearch, UpdateSourceTrigger=PropertyChanged}" Placeholder="Name, acronym or ID"/>
              <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource FilterChip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Valued only" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LimitedsValuedOnly}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource FilterChip}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rare only" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LimitedsRareOnly}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource FilterChip}" Margin="0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Hide projected" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LimitedsHideProjected}"/>
                  </StackPanel>
                </Border>
              </WrapPanel>
            </Grid>
            <!-- a range on one number -->
            <Grid Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter on" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,10,0"/>
                <ComboBox Width="150" Height="46" ItemsSource="{Binding LimitedFilterFields}" SelectedItem="{Binding LimitedsFilterField}" DisplayMemberPath="Name"
                          VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                <Grid Width="120" Height="46" Margin="0,0,8,0">
                  <TextBox Text="{Binding LimitedsMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RangeBox}"/>
                  <TextBlock Text="Min" Style="{StaticResource RangeLabel}"/>
                </Grid>
                <Grid Width="120" Height="46">
                  <TextBox Text="{Binding LimitedsMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RangeBox}"/>
                  <TextBlock Text="Max" Style="{StaticResource RangeLabel}"/>
                </Grid>
              </StackPanel>
              <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding LimitedsCount}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding LimitedsStatus}" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>

            <!-- the table (scrolls sideways when the window is narrow) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Border Style="{StaticResource CardBox}" Padding="10,6,10,10" MinWidth="960">
                <StackPanel>
                  <Grid Margin="8,4,8,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/><ColumnDefinition Width="*" MinWidth="170"/><ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="92"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
                  <ColumnDefinition Width="76"/><ColumnDefinition Width="80"/><ColumnDefinition Width="42"/><ColumnDefinition Width="76"/>
                  <ColumnDefinition Width="70"/><ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="name">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Name"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=name}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="acronym">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Acronym"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=acronym}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="best">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Best price"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=best}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="rap">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RAP"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=rap}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="value">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Value"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=value}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="demand">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Demand"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=demand}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="7" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="trend">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Trend"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=trend}"/>
                  </StackPanel>
                </Button>
                <TextBlock Grid.Column="8" Text="Rare" Style="{StaticResource TableHeadText}"/>
                <TextBlock Grid.Column="9" Text="Projected" Style="{StaticResource TableHeadText}"/>
                <Button Grid.Column="10" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="copies">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Copies"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=copies}"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="11" Style="{StaticResource TableHead}" Command="{Binding SortLimitedsCommand}" CommandParameter="favorites">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Favorites"/>
                    <TextBlock Text="{Binding LimitedsSortArrow}" FontFamily="{StaticResource Icons}" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" Visibility="{Binding LimitedsSortKey, Converter={StaticResource PageVis}, ConverterParameter=favorites}"/>
                  </StackPanel>
                </Button>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,4"/>
                  <ItemsControl ItemsSource="{Binding LimitedRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.OpenLimitedRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                          <Border x:Name="b" CornerRadius="8" Padding="8,5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                            <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="44"/><ColumnDefinition Width="*" MinWidth="170"/><ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="92"/><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
                  <ColumnDefinition Width="76"/><ColumnDefinition Width="80"/><ColumnDefinition Width="42"/><ColumnDefinition Width="76"/>
                  <ColumnDefinition Width="70"/><ColumnDefinition Width="76"/>
                </Grid.ColumnDefinitions>
                              <Grid Width="34" Height="34" HorizontalAlignment="Left">
                                <Border CornerRadius="7" Background="{DynamicResource Card2}"/>
                                <ctl:RemoteImage Url="{Binding ThumbUrl}" CornerRadius="7"/>
                              </Grid>
                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" Margin="8,0,0,0"
                                        Visibility="{Binding Hyped, Converter={StaticResource BoolVis}}" ToolTip="Hyped">
                                  <TextBlock Text="Hyped" Style="{StaticResource BadgeText}" FontSize="10" Foreground="{DynamicResource Accent}"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Acronym}" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Grid.Column="3" Text="{Binding BestText}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="4" Text="{Binding RapText}" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="5" Text="{Binding ValueText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                              <TextBlock Grid.Column="6" Text="{Binding DemandText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                              <TextBlock Grid.Column="7" Text="{Binding TrendText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                              <Rectangle Grid.Column="8" Width="9" Height="9" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="6,0,0,0" ToolTip="Rare" Visibility="{Binding Rare, Converter={StaticResource BoolVis}}">
                                <Rectangle.RenderTransform><RotateTransform Angle="45" CenterX="4.5" CenterY="4.5"/></Rectangle.RenderTransform>
                              </Rectangle>
                              <Border Grid.Column="9" Style="{StaticResource Badge}" Background="{DynamicResource RedBg}" HorizontalAlignment="Left"
                                      Visibility="{Binding Projected, Converter={StaticResource BoolVis}}" ToolTip="Its RAP was pushed up on purpose">
                                <TextBlock Text="Projected" Style="{StaticResource BadgeText}" FontSize="10" Foreground="{DynamicResource Red}"/>
                              </Border>
                              <TextBlock Grid.Column="10" Text="{Binding CopiesText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                              <TextBlock Grid.Column="11" Text="{Binding FavoritesText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                            </Grid>
                          </Border>
                        </Button>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Odd}" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></DataTrigger>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLine}"/></Trigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Nothing matches these filters." Style="{StaticResource MutedText}" Margin="8,10,0,6"
                             Visibility="{Binding LimitedRows.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>
                </StackPanel>
              </Border>
            </ScrollViewer>
            <Button Content="Show more" ctl:Btn.Icon="&#xE70D;" HorizontalAlignment="Center" Padding="22,10" Margin="0,12,0,0" Command="{Binding ShowMoreLimitedsCommand}"
                    Visibility="{Binding LimitedsHasMore, Converter={StaticResource BoolVis}}"/>
            <TextBlock FontSize="11" Style="{StaticResource MutedText}" Margin="2,12,0,0" TextWrapping="Wrap"
                       Text="Value, RAP, demand, trend, rare, projected and hyped from Rolimons. Best price, copies and favorites from Roblox. Owners, premium copies and hoarded aren't in any public API, so they can't be shown."/>
          </StackPanel>

          <!-- one limited: the item page, shared with the Marketplace -->
          <local:ItemPageView Visibility="{Binding IsLimitedOpen, Converter={StaticResource BoolVis}}"/>
        </Grid>

        <!-- ================= INVENTORY VALUE ================= -->
        <StackPanel Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Inventory}">
          <Grid Margin="0,0,0,14">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="All accounts" FontSize="12" Style="{StaticResource MutedText}"/>
              <TextBlock Text="{Binding WorthTotal}" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0" Command="{Binding LoadWorthsCommand}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Content" Value="Refresh"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WorthsLoading}" Value="True">
                      <Setter Property="Content" Value="Checking…"/><Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ItemsControl ItemsSource="{Binding AccountWorths}" VerticalAlignment="Top">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource CardButton}" Margin="0,0,0,8" HorizontalContentAlignment="Stretch"
                          Command="{Binding DataContext.SelectWorthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ctl:AvatarView Width="36" Height="36" Url="{Binding Account.AvatarUrl}"/>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Account.Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Note}" FontSize="11" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ValueText}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"/>
                          <TextBlock Text="{Binding RapText, StringFormat='RAP {0}'}" FontSize="11" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="2" IsIndeterminate="True" Width="50" Height="3" BorderThickness="0" Foreground="{DynamicResource Accent}"
                                     Background="{DynamicResource Line}" VerticalAlignment="Center"
                                     Visibility="{Binding Loading, Converter={StaticResource BoolVis}}"/>
                      </Grid>
                    </Border>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="2">
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,10" Visibility="{Binding SelectedWorth, Converter={StaticResource NullCollapsed}}">
                <Run Text="{Binding SelectedWorth.Account.Label, Mode=OneWay}"/><Run Text="'s limiteds, most valuable first"/>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding WorthItems}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource CardButton}" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                            Command="{Binding DataContext.OpenLimitedFromInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- ================= MY TRADES ================= -->
        <StackPanel Visibility="{Binding TradesTab, Converter={StaticResource PageVis}, ConverterParameter=Trades}">
          <Border Style="{StaticResource CardBox}" Padding="16,10" Margin="0,0,0,14" BorderBrush="{DynamicResource Red}"
                  Visibility="{Binding CanTradeNote, Converter={StaticResource EmptyCollapsed}}">
            <TextBlock Text="{Binding CanTradeNote}" TextWrapping="Wrap"/>
          </Border>
          <Grid Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Seg}" Content="Inbound" GroupName="tradetype"
                           IsChecked="{Binding TradeType, Converter={StaticResource Eq}, ConverterParameter=Inbound, Mode=TwoWay}"/>
              <RadioButton Style="{StaticResource Seg}" Content="Outbound" GroupName="tradetype"
                           IsChecked="{Binding TradeType, Converter={StaticResource Eq}, ConverterParameter=Outbound, Mode=TwoWay}"/>
              <RadioButton Style="{StaticResource Seg}" Content="Completed" GroupName="tradetype"
                           IsChecked="{Binding TradeType, Converter={StaticResource Eq}, ConverterParameter=Completed, Mode=TwoWay}"/>
              <RadioButton Style="{StaticResource Seg}" Content="Inactive" GroupName="tradetype" Margin="0"
                           IsChecked="{Binding TradeType, Converter={StaticResource Eq}, ConverterParameter=Inactive, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshTradesCommand}"/>
              <Button Style="{StaticResource Primary}" Content="New trade" Margin="0" Command="{Binding NewTradeCommand}"/>
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="380"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ctl:StateView State="{Binding TradesLoad.State}" Message="{Binding TradesLoad.Message}" MinHeight="200" VerticalAlignment="Top"
                           EmptyText="No trades here." RetryCommand="{Binding RefreshTradesCommand}">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding TradeRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource CardButton}" Margin="0,0,0,6" HorizontalContentAlignment="Stretch"
                              Command="{Binding DataContext.OpenTradeRowItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,9">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ctl:AvatarView Width="44" Height="44" Url="{Binding HeadshotUrl}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding PartnerLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding PartnerName}"/>
                              <!-- always takes its line, so the row doesn't grow when the value arrives -->
                              <TextBlock Text="{Binding PartnerWorth}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Gold}" Margin="0,1,0,0"
                                         ToolTip="Their inventory value"/>
                              <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Padding="10,2" Margin="0,0,6,0" FontSize="11" Focusable="False" Foreground="White" Background="#B5363C" BorderThickness="0"
                                        Command="{Binding DataContext.DeclineRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Visibility="{Binding IsActive, Converter={StaticResource BoolVis}}">
                                  <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                      <Setter Property="Content" Value="Decline"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.TradeType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Outbound">
                                          <Setter Property="Content" Value="Cancel"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Button.Style>
                                </Button>
                                <Button Padding="10,2" Margin="0" FontSize="11" Focusable="False" ToolTip="Their limiteds and value over time"
                                        Command="{Binding DataContext.OpenTradeProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="Profile"/>
                                  </StackPanel>
                                </Button>
                                <Border Style="{StaticResource Badge}" Background="{DynamicResource Red}" Margin="6,0,0,0" ToolTip="Someone doesn't have an item in this trade anymore"
                                        Visibility="{Binding HasGone, Converter={StaticResource BoolVis}}">
                                  <TextBlock Text="Item gone" Style="{StaticResource BadgeText}" FontSize="10" Foreground="White"/>
                                </Border>
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding AgoText}" FontSize="11" Style="{StaticResource MutedText}" VerticalAlignment="Top"
                                       Margin="0,0,10,0" ToolTip="{Binding WhenText}"/>
                            <!-- what you give over what you get, with a bar: green = you gain value, red = you lose -->
                            <Grid Grid.Column="3" VerticalAlignment="Center" MinWidth="70">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <Border Width="6" CornerRadius="3" Margin="0,0,8,0" Tag="{Binding Result}">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Line}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Result}" Value="1"><Setter Property="Background" Value="{DynamicResource Green}"/></DataTrigger>
                                      <DataTrigger Binding="{Binding Result}" Value="-1"><Setter Property="Background" Value="{DynamicResource Red}"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GiveText}" FontWeight="SemiBold" HorizontalAlignment="Right" ToolTip="You give (value)"/>
                                <TextBlock Text="{Binding GetText}" FontWeight="SemiBold" HorizontalAlignment="Right" ToolTip="You get (value)"/>
                              </StackPanel>
                            </Grid>
                          </Grid>
                        </Border>
                      </Button>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Load more" ctl:Btn.Icon="&#xE70D;" HorizontalAlignment="Center" Command="{Binding LoadMoreTradesCommand}"
                        Visibility="{Binding TradesHasMore, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </ctl:StateView>

            <!-- nothing picked yet -->
            <Border Grid.Column="2" CornerRadius="16" BorderThickness="1.5" Padding="24,40" VerticalAlignment="Top" MinHeight="220"
                    Visibility="{Binding IsTradeOpen, Converter={StaticResource BoolVisInv}}">
              <Border.BorderBrush>
                <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                  <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="{DynamicResource Line}">
                      <GeometryDrawing.Geometry>
                        <GeometryGroup><RectangleGeometry Rect="0,0,4,4"/><RectangleGeometry Rect="4,4,4,4"/></GeometryGroup>
                      </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Border.BorderBrush>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a trade" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="Pick one on the left to see its items, values and what to do with it." Style="{StaticResource MutedText}"
                           FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- the opened trade -->
            <Border Grid.Column="2" Style="{StaticResource CardBox}" Padding="22,18" VerticalAlignment="Top"
                    Visibility="{Binding IsTradeOpen, Converter={StaticResource BoolVis}}">
              <ctl:StateView State="{Binding TradeLoad.State}" Message="{Binding TradeLoad.Message}" MinHeight="200">
                <StackPanel>
                  <Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,40,0">
                      <TextBlock FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <Run Text="Trade with"/> <Run Text="{Binding OpenTradeRow.PartnerLabel, Mode=OneWay}"/>
                        <Run Text="{Binding OpenTradeRow.PartnerName, Mode=OneWay, StringFormat='@{0}'}" Foreground="{DynamicResource Muted}" FontWeight="Normal"/>
                      </TextBlock>
                      <Button Style="{StaticResource IconBtn}" Content="&#xE77B;" Margin="6,0,0,0" ToolTip="Their profile: limiteds and value over time"
                              Command="{Binding OpenTradeProfileCommand}" CommandParameter="{Binding OpenTradeRow}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0" ToolTip="Close"
                            Command="{Binding CloseTradeCommand}"/>
                  </Grid>
                  <TextBlock Text="{Binding TradeSubtitle}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                  <!-- someone doesn't have an item anymore -->
                  <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="12" Background="{DynamicResource RedBg}" BorderBrush="{DynamicResource Red}" BorderThickness="1"
                          Visibility="{Binding TradeGoneNote, Converter={StaticResource EmptyCollapsed}}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Red}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                      <TextBlock Grid.Column="1" Text="{Binding TradeGoneNote}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </Grid>
                  </Border>

                  <!-- give -->
                  <TextBlock Text="{Binding TradeGiveTitle}" FontSize="16" FontWeight="Bold" Margin="0,18,0,10"/>
                  <ItemsControl ItemsSource="{Binding TradeGive}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0" Content="{Binding}" ContentTemplate="{StaticResource TradeItemCard}"
                                Command="{Binding DataContext.OpenLimitedFromInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Grid Margin="0,2,0,0" Visibility="{Binding TradeGiveRobux, Converter={StaticResource EmptyCollapsed}}">
                    <TextBlock Text="Robux you add:" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TradeGiveRobux}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <TextBlock Text="Total value:" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <StackPanel HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TradeGiveValue}" FontWeight="Bold" FontSize="15"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TradeGiveRap}" FontWeight="Bold" FontSize="15"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <!-- the difference: what you get minus what you give -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,12">
                    <Border Style="{StaticResource DiffPill}" Tag="{Binding TradeValueDiffKind}" ToolTip="Value difference">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TradeValueDiff}" FontSize="12" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DiffPill}" Tag="{Binding TradeRapDiffKind}" ToolTip="RAP difference">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TradeRapDiff}" FontSize="12" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,4"/>

                  <!-- get -->
                  <TextBlock Text="{Binding TradeGetTitle}" FontSize="16" FontWeight="Bold" Margin="0,12,0,10"/>
                  <ItemsControl ItemsSource="{Binding TradeGet}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="0" Content="{Binding}" ContentTemplate="{StaticResource TradeItemCard}"
                                Command="{Binding DataContext.OpenLimitedFromInventoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  </ItemsControl>
                  <Grid Margin="0,2,0,0" Visibility="{Binding TradeGetRobux, Converter={StaticResource EmptyCollapsed}}">
                    <TextBlock Text="Robux offered (after 30% fee):" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TradeGetRobux}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <TextBlock Text="Total value:" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <StackPanel HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TradeGetValue}" FontWeight="Bold" FontSize="15"/>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TradeGetRap}" FontWeight="Bold" FontSize="15"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding TradeCanRespond, Converter={StaticResource BoolVis}}">
                    <Button Content="Accept" ctl:Btn.Icon="&#xE8FB;" Style="{StaticResource Primary}" Command="{Binding AcceptTradeCommand}"/>
                    <Button Content="Counter" ctl:Btn.Icon="&#xE8AB;" Command="{Binding CounterTradeCommand}"/>
                    <Button Content="Decline" ctl:Btn.Icon="&#xE711;" Margin="0" Command="{Binding DeclineTradeCommand}"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding TradeCanCancel, Converter={StaticResource BoolVis}}">
                    <Button Content="Cancel trade" Margin="0" Command="{Binding DeclineTradeCommand}"/>
                  </StackPanel>
                  <TextBlock Text="Values from Rolimons (RAP when an item has no value). Robux you get count after Roblox's 30% fee."
                             FontSize="11" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </ctl:StateView>
            </Border>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= making a trade ================= -->
    <Grid Visibility="{Binding IsBuildingTrade, Converter={StaticResource BoolVis}}" Background="{DynamicResource Page}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,32">
          <Grid>
            <TextBlock Text="{Binding BuildTitle}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0" ToolTip="Close"
                    Command="{Binding CloseBuildCommand}"/>
          </Grid>

          <!-- who with -->
          <Border Style="{StaticResource CardBox}" Padding="18,14" Margin="0,16,0,16">
            <Grid>
              <StackPanel Visibility="{Binding BuildPartnerId, Converter={StaticResource CountVis}, ConverterParameter=Inverse}">
                <TextBlock Text="Who do you want to trade with?" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <ctl:SearchBox Width="320" HorizontalAlignment="Left" Text="{Binding PartnerSearch}" Placeholder="Their username, press Enter"
                               SubmitCommand="{Binding SearchPartnerCommand}"/>
                <ItemsControl ItemsSource="{Binding PartnerHits}" Margin="0,10,0,0">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource Chip}" Margin="0,0,8,8"
                              Command="{Binding DataContext.PickPartnerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                          <ctl:AvatarView Width="22" Height="22" Url="{Binding HeadshotUrl}" Margin="0,0,8,0"/>
                          <TextBlock VerticalAlignment="Center"><Run Text="{Binding Label, Mode=OneWay}"/> <Run Text="{Binding Name, Mode=OneWay, StringFormat='@{0}'}" Foreground="{DynamicResource Muted}"/></TextBlock>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Visibility="{Binding BuildPartnerId, Converter={StaticResource CountVis}}">
                <ctl:AvatarView Width="40" Height="40" Url="{Binding BuildPartnerHead}"/>
                <TextBlock VerticalAlignment="Center" Margin="12,0,16,0" FontSize="15">
                  <Run Text="{Binding CurrentAccount.Label, Mode=OneWay}"/> <Run Text="⇄" Foreground="{DynamicResource Muted}"/> <Run Text="{Binding BuildPartnerName, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>
                <Button Content="Someone else" Command="{Binding NewTradeCommand}" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- the offer so far -->
          <Border Style="{StaticResource CardBox}" Padding="18,14" Margin="0,0,0,16">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="You give" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding BuildGiveText}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding BuildGive}" MinHeight="40">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                                Command="{Binding DataContext.ToggleGiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+ Robux" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding BuildGiveRobux, UpdateSourceTrigger=PropertyChanged}" Width="100" Style="{StaticResource NumBox}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="You get" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding BuildGetText}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding BuildGet}" MinHeight="40">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                                Command="{Binding DataContext.ToggleGetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+ Robux" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding BuildGetRobux, UpdateSourceTrigger=PropertyChanged}" Width="100" Style="{StaticResource NumBox}"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <Grid Margin="0,16,0,0">
                <TextBlock Text="{Binding BuildVerdict}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,160,0"
                           Style="{StaticResource VerdictText}" Tag="{Binding BuildVerdictKind}"/>
                <Button Style="{StaticResource Primary}" Content="Send trade…" HorizontalAlignment="Right" Margin="0" Padding="20,10"
                        Command="{Binding SendTradeCommand}" IsEnabled="{Binding CanSendTrade}"/>
              </Grid>
              <TextBlock Text="Up to 4 items per side. Robux you get count at 70 %: Roblox keeps 30 %." FontSize="11" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- both inventories -->
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"><Run Text="{Binding CurrentAccount.Label, Mode=OneWay}"/><Run Text="'s limiteds"/></TextBlock>
                <ctl:SearchBox Width="180" HorizontalAlignment="Right" Text="{Binding MyTradableFilter, UpdateSourceTrigger=PropertyChanged}" Placeholder="Filter"/>
              </Grid>
              <ctl:StateView State="{Binding MyTradableLoad.State}" Message="{Binding MyTradableLoad.Message}" MinHeight="120"
                             EmptyText="No tradable limiteds on this account.">
                <ItemsControl ItemsSource="{Binding MyTradable}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource CardButton}" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                              Command="{Binding DataContext.ToggleGiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ctl:StateView>
            </StackPanel>
            <StackPanel Grid.Column="2" Visibility="{Binding BuildPartnerId, Converter={StaticResource CountVis}}">
              <Grid Margin="0,0,0,10">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"><Run Text="{Binding BuildPartnerName, Mode=OneWay}"/><Run Text="'s limiteds"/></TextBlock>
                <ctl:SearchBox Width="180" HorizontalAlignment="Right" Text="{Binding TheirTradableFilter, UpdateSourceTrigger=PropertyChanged}" Placeholder="Filter"/>
              </Grid>
              <ctl:StateView State="{Binding TheirTradableLoad.State}" Message="{Binding TheirTradableLoad.Message}" MinHeight="120"
                             EmptyText="They have no tradable limiteds, or their inventory is private.">
                <ItemsControl ItemsSource="{Binding TheirTradable}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource CardButton}" Content="{Binding}" ContentTemplate="{StaticResource LimitedCard}"
                              Command="{Binding DataContext.ToggleGetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ctl:StateView>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ================= buy a deal or a seller's copy, right here ================= -->
    <local:BuyCardView/>

    <!-- ================= switching insta-buy on: a warning, every time ================= -->
    <Grid Visibility="{Binding ShowInstaBuyWarning, Converter={StaticResource BoolVis}}" Background="#B0000000">
      <Border Style="{StaticResource CardBox}" Width="470" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Card}" BorderBrush="{DynamicResource Red}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource RedBg}" Margin="0,0,12,0">
              <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Red}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Turn on insta-buy?" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Red}"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" LineHeight="20"
                     Text="With insta-buy on, pressing Buy on a deal spends Robux straight away. There's no confirm card and no way to undo it."/>
          <StackPanel Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" LineHeight="20" Style="{StaticResource MutedText}" Text="•  It buys the cheapest copy for sale right then, with the account top right."/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" Style="{StaticResource MutedText}" Text="•  It only buys at the price the deal showed or less. If someone bought that copy first, nothing is bought."/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" Style="{StaticResource MutedText}" Text="•  Your spending limit in Settings still applies."/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" Style="{StaticResource MutedText}" Text="•  It turns off again when RoDeck closes."/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Red}"
                     Text="Values and RAP can be wrong or manipulated. You use insta-buy at your own risk."/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Command="{Binding CancelInstaBuyCommand}" IsCancel="True"/>
            <Button Margin="0" Style="{StaticResource Primary}" Background="{DynamicResource Red}" BorderBrush="{DynamicResource Red}" Foreground="White"
                    Content="Turn on insta-buy" Command="{Binding ConfirmInstaBuyCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= confirm before any trade action ================= -->
    <Grid Visibility="{Binding ShowTradeConfirm, Converter={StaticResource BoolVis}}" Background="#B0000000">
      <Border Style="{StaticResource CardBox}" Width="460" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{DynamicResource Card}">
        <StackPanel>
          <TextBlock Text="{Binding TradeConfirmTitle}" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="{Binding TradeConfirmBody}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="20"/>
          <TextBlock Text="{Binding TradeConfirmError}" Foreground="{DynamicResource Red}" Margin="0,12,0,0" TextWrapping="Wrap"
                     Visibility="{Binding TradeConfirmError, Converter={StaticResource EmptyCollapsed}}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Back" Command="{Binding CancelTradeConfirmCommand}" IsCancel="True"/>
            <Button Margin="0" Command="{Binding ConfirmTradeCommand}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                  <Setter Property="Content" Value="{Binding TradeConfirmButton}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding TradeConfirmDanger}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource Red}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding TradeBusy}" Value="True">
                      <Setter Property="Content" Value="Working…"/><Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
