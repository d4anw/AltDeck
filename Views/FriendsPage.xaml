<UserControl x:Class="RoDeck.Views.FriendsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls">
  <UserControl.Resources>
    <!-- a friend: picture with status dot (and a star for favourites), name, what they're doing. Click: menu. -->
    <DataTemplate x:Key="FriendCard">
      <Button Width="236" Margin="0,0,12,12" Padding="12,10" HorizontalContentAlignment="Stretch" Cursor="Hand" Focusable="False"
              Click="Friend_Click" MouseRightButtonUp="Friend_RightClick">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="14" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Width="46" Height="46">
            <ctl:AvatarView Url="{Binding HeadshotUrl}" Initials="{Binding Initials}"/>
            <Border Width="14" Height="14" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    BorderThickness="2.5" BorderBrush="{DynamicResource Card}"
                    Background="{Binding StatusKind, Converter={StaticResource StatusBrush}}"/>
            <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-4,0,0"
                    Background="{DynamicResource Accent}" Visibility="{Binding IsFavourite, Converter={StaticResource BoolVis}}">
              <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="9" Foreground="{DynamicResource AccentFg}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding PresenceType}" Value="2"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <!-- ================= list: friends / requests / find ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolVisInv}}">
      <StackPanel Margin="32,26,32,32">
        <Grid>
          <StackPanel>
            <TextBlock Text="Friends" FontSize="28" FontWeight="Bold"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}">
              <Run Text="{Binding FriendsSummary, Mode=OneWay}"/><Run Text="  ·  as "/><Run Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue='no account'}"/>
            </TextBlock>
          </StackPanel>
          <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"
                  ToolTip="Refresh" Command="{Binding RefreshFriendsCommand}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,18,0,16">
          <RadioButton Style="{StaticResource Seg}" Content="Friends" GroupName="friendstab"
                       IsChecked="{Binding FriendsTab, Converter={StaticResource Eq}, ConverterParameter=Friends, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Seg}" GroupName="friendstab"
                       IsChecked="{Binding FriendsTab, Converter={StaticResource Eq}, ConverterParameter=Requests, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Requests" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Badge}" Background="{DynamicResource Red}" Margin="8,0,0,0"
                      Visibility="{Binding HasRequests, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding RequestCount}" Style="{StaticResource BadgeText}" Foreground="White"/>
              </Border>
            </StackPanel>
          </RadioButton>
          <RadioButton Style="{StaticResource Seg}" Content="Find players" GroupName="friendstab" Margin="0"
                       IsChecked="{Binding FriendsTab, Converter={StaticResource Eq}, ConverterParameter=Find, Mode=TwoWay}"/>
        </StackPanel>

        <!-- friends -->
        <StackPanel Visibility="{Binding FriendsTab, Converter={StaticResource PageVis}, ConverterParameter=Friends}">
          <ctl:SearchBox Width="320" HorizontalAlignment="Left" Margin="0,0,0,14" Text="{Binding FriendsFilter}" Placeholder="Filter your friends"/>
          <ctl:StateView State="{Binding AllFriendsLoad.State}" Message="{Binding AllFriendsLoad.Message}" MinHeight="200"
                         EmptyText="This account has no friends yet. Find players in the tab above."
                         RetryCommand="{Binding RefreshFriendsCommand}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding AllFriends}" ItemTemplate="{StaticResource FriendCard}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <TextBlock Text="No friends match that." Style="{StaticResource MutedText}" Margin="2,4,0,0"
                         Visibility="{Binding AllFriends.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>
              <Button Content="{Binding MoreFriendsText}" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding ShowMoreFriendsCommand}"
                      Visibility="{Binding HasMoreFriends, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </ctl:StateView>
        </StackPanel>

        <!-- requests -->
        <ctl:StateView Visibility="{Binding FriendsTab, Converter={StaticResource PageVis}, ConverterParameter=Requests}"
                       State="{Binding RequestsLoad.State}" Message="{Binding RequestsLoad.Message}" MinHeight="200"
                       EmptyText="No friend requests right now." RetryCommand="{Binding RefreshFriendsCommand}">
          <!-- as many columns as fit (about 460 px each), so a wide window isn't half empty -->
          <ItemsControl ItemsSource="{Binding Requests}" SizeChanged="Requests_SizeChanged" Margin="0,0,-10,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="1" VerticalAlignment="Top" Loaded="RequestsGrid_Loaded"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="14" Padding="14,10" Margin="0,0,10,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ctl:AvatarView Width="44" Height="44" Url="{Binding HeadshotUrl}" Initials="{Binding Initials}"/>
                    <!-- Focusable off on everything in a request row: when the row disappears, Windows would otherwise move
                         focus to another row and scroll the page there -->
                    <Button Grid.Column="1" Style="{StaticResource Subtle}" HorizontalAlignment="Left" Margin="6,0,0,0" Padding="6,4" Focusable="False"
                            Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="View profile">
                      <StackPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                        <TextBlock Text="{Binding Info}" FontSize="12" Style="{StaticResource MutedText}"/>
                      </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="Decline" MinWidth="96" Focusable="False" Command="{Binding DataContext.DeclineRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                      <Button Content="Accept" Style="{StaticResource Primary}" Margin="0" MinWidth="96" Focusable="False"
                              Command="{Binding DataContext.AcceptRequestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ctl:StateView>

        <!-- find players -->
        <StackPanel Visibility="{Binding FriendsTab, Converter={StaticResource PageVis}, ConverterParameter=Find}">
          <ctl:SearchBox Width="420" HorizontalAlignment="Left" Margin="0,0,0,14" Text="{Binding PlayerSearchText}"
                         Placeholder="Username or user ID, press Enter" SubmitCommand="{Binding SearchPlayersCommand}"/>
          <ctl:StateView State="{Binding PlayersLoad.State}" Message="{Binding PlayersLoad.Message}" MinHeight="160"
                         EmptyText="No players found with that name." RetryCommand="{Binding SearchPlayersCommand}">
            <ItemsControl ItemsSource="{Binding PlayerHits}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="236" Margin="0,0,12,12" Padding="12,10" HorizontalContentAlignment="Stretch" Cursor="Hand"
                          Command="{Binding DataContext.OpenProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <ctl:AvatarView Width="46" Height="46" Url="{Binding HeadshotUrl}" Initials="{Binding Initials}"/>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                          <TextBlock Text=" ✓" Foreground="{DynamicResource Blue}" Visibility="{Binding Verified, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Name, StringFormat='@{0}'}" FontSize="12" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ctl:StateView>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- ================= a profile ================= -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolVis}}">
      <StackPanel Margin="32,22,32,32">
        <Button Style="{StaticResource Subtle}" HorizontalAlignment="Left" Command="{Binding CloseProfileCommand}" Margin="-8,0,0,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Back to Friends"/>
          </StackPanel>
        </Button>

        <ctl:StateView State="{Binding ProfileLoad.State}" Message="{Binding ProfileLoad.Message}" MinHeight="300"
                       RetryCommand="{Binding RetryOpenProfileCommand}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="260" Height="260" CornerRadius="22" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <ctl:RemoteImage Url="{Binding OpenProfile.AvatarUrl}" CornerRadius="21" Background="Transparent" Stretch="Uniform"/>
              </Border>

              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding OpenProfile.Label}" FontSize="28" FontWeight="Bold"/>
                  <TextBlock Text=" ✓" FontSize="24" Foreground="{DynamicResource Blue}" VerticalAlignment="Center"
                             Visibility="{Binding OpenProfile.Verified, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"/>
                </StackPanel>
                <TextBlock Text="{Binding OpenProfile.Name, StringFormat='@{0}'}" Margin="0,2,0,0" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                           Fill="{Binding ProfileStatusKind, Converter={StaticResource StatusBrush}}"/>
                  <TextBlock Text="{Binding ProfileStatus}" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding ProfileCounts}" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ProfileJoined}" Margin="0,4,0,0" FontSize="12" Style="{StaticResource MutedText}"/>

                <WrapPanel Margin="0,18,0,0" Visibility="{Binding ProfileIsMe, Converter={StaticResource BoolVisInv}}">
                  <Button x:Name="FriendBtn" Click="FriendBtn_Click" Margin="0,0,8,8" Padding="18,10"
                          Visibility="{Binding ProfileFriendButton, Converter={StaticResource EmptyCollapsed}}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                        <Style.Triggers>
                          <!-- already friends / request pending: a calm button instead of the orange one -->
                          <DataTrigger Binding="{Binding OpenProfile.Friendship}" Value="Friends">
                            <Setter Property="Background" Value="{DynamicResource Card2}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                            <Setter Property="ToolTip" Value="Click to unfriend"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding OpenProfile.Friendship}" Value="RequestSent">
                            <Setter Property="Background" Value="{DynamicResource Card2}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                    <TextBlock><Run Text="{Binding ProfileFriendButton, Mode=OneWay}"/></TextBlock>
                  </Button>
                  <Button Style="{StaticResource Primary}" Margin="0,0,8,8" Padding="18,10" Command="{Binding ProfileJoinCommand}"
                          Visibility="{Binding ProfileCanJoin, Converter={StaticResource BoolVis}}">
                    <TextBlock><Run Text="Join as"/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay}"/></TextBlock>
                  </Button>
                  <Button Content="Join with alts…" ctl:Btn.Icon="&#xE716;" Margin="0,0,8,8" Command="{Binding ProfileJoinWithAltsCommand}"
                          Visibility="{Binding ProfileCanJoin, Converter={StaticResource BoolVis}}"/>
                  <Button Margin="0,0,8,8" Command="{Binding ProfileToggleFavouriteCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE734;"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ProfileIsFavourite}" Value="True">
                                <Setter Property="Text" Value="&#xE735;"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="Favourite"/>
                    </StackPanel>
                  </Button>
                  <Button Content="Roblox.com" ctl:Btn.External="True" Margin="0,0,8,8" Command="{Binding ProfileOnWebCommand}"/>
                </WrapPanel>
              </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBox}" Margin="0,22,0,0" Padding="22,18"
                    Visibility="{Binding OpenProfile.About, Converter={StaticResource EmptyCollapsed}, FallbackValue=Collapsed}">
              <StackPanel>
                <TextBlock Text="About" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding OpenProfile.About}" TextWrapping="Wrap" LineHeight="21" Style="{StaticResource MutedText}"/>
                </ScrollViewer>
              </StackPanel>
            </Border>

            <StackPanel Margin="0,22,0,0" Visibility="{Binding OpenProfile.Games.Count, Converter={StaticResource CountVis}, FallbackValue=Collapsed}">
              <TextBlock Text="Their games" FontSize="18" FontWeight="Bold" Margin="2,0,0,12"/>
              <ItemsControl ItemsSource="{Binding OpenProfile.Games}" ItemTemplate="{StaticResource GameTileTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ctl:StateView>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
