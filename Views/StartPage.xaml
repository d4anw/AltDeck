<UserControl x:Class="AltDeck.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:AltDeck.Controls">
  <UserControl.Resources>
    <!-- a row's header: title, refresh / scroll buttons -->
    <Style x:Key="RowScroll" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,26,32,32">

      <!-- greeting -->
      <Border Style="{StaticResource CardBox}" Padding="26,22">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ctl:AvatarView Width="64" Height="64" Url="{Binding CurrentAccount.AvatarUrl}" Initials="{Binding CurrentAccount.Initials}"/>
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis">
              <Run Text="Hi,"/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue=there, TargetNullValue=there}"/>
            </TextBlock>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}"
                       Text="{Binding CurrentAccount.Username, Mode=OneWay, StringFormat='@{0}', FallbackValue='Add an account to get started.'}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0"
                        Visibility="{Binding CurrentAccount.RobuxText, Converter={StaticResource EmptyCollapsed}, FallbackValue=Collapsed}">
              <TextBlock Text="Robux" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right"/>
              <TextBlock Text="{Binding CurrentAccount.RobuxText, Mode=OneWay}" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
            </StackPanel>
            <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Refresh Home" Margin="0"
                    Command="{Binding RefreshHomeCommand}"
                    Visibility="{Binding HasCurrentAccount, Converter={StaticResource BoolVis}}"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- no account yet -->
      <Border Style="{StaticResource CardBox}" Margin="0,16,0,0"
              Visibility="{Binding HasCurrentAccount, Converter={StaticResource BoolVisInv}}">
        <StackPanel>
          <TextBlock Text="Add your first account" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Margin="0,4,0,14" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="Sign in through a browser window, paste cookies, or import a file. Everything stays encrypted on this PC."/>
          <Button Content="Go to Accounts" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0"
                  Command="{Binding GoMultiTabCommand}" CommandParameter="Accounts"/>
        </StackPanel>
      </Border>

      <StackPanel Visibility="{Binding HasCurrentAccount, Converter={StaticResource BoolVis}}">

        <!-- friends online -->
        <Grid Margin="2,26,0,10">
          <TextBlock Text="{Binding FriendsTitle}" FontSize="18" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="30" Height="30" Click="ScrollLeft_Click" Tag="{Binding ElementName=FriendsRow}"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="30" Height="30" Margin="0" Click="ScrollRight_Click" Tag="{Binding ElementName=FriendsRow}"/>
          </StackPanel>
        </Grid>
        <ctl:StateView State="{Binding FriendsLoad.State}" Message="{Binding FriendsLoad.Message}" MinHeight="120"
                       EmptyText="None of this account's friends are online right now." RetryCommand="{Binding RefreshHomeCommand}">
          <ScrollViewer x:Name="FriendsRow" Style="{StaticResource RowScroll}" PreviewMouseWheel="Row_Wheel">
            <ItemsControl ItemsSource="{Binding OnlineFriends}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="104" Margin="0,0,10,0" Padding="6,10" Cursor="Hand"
                          Click="Friend_Click" MouseRightButtonUp="Friend_RightClick">
                    <Button.ToolTip>
                      <TextBlock>
                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" (@"/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=")"/>
                        <LineBreak/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                      </TextBlock>
                    </Button.ToolTip>
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                      <Grid Width="64" Height="64" HorizontalAlignment="Center">
                        <ctl:AvatarView Url="{Binding HeadshotUrl}" Initials="{Binding Initials}"/>
                        <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                BorderThickness="3" BorderBrush="{DynamicResource Page}"
                                Background="{Binding StatusKind, Converter={StaticResource StatusBrush}}"/>
                        <!-- favourite friend -->
                        <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-4,-4,0,0" Background="{DynamicResource Accent}"
                                Visibility="{Binding IsFavourite, Converter={StaticResource BoolVis}}" ToolTip="Favourite friend">
                          <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource AccentFg}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Label}" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" MaxWidth="92"/>
                      <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                 MaxWidth="92" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </ctl:StateView>

        <!-- continue playing -->
        <Grid Margin="2,26,0,10" Visibility="{Binding ContinueGames.Count, Converter={StaticResource CountVis}}">
          <TextBlock Text="Continue playing" FontSize="18" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="30" Height="30" Click="ScrollLeft_Click" Tag="{Binding ElementName=ContinueRow}"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="30" Height="30" Margin="0" Click="ScrollRight_Click" Tag="{Binding ElementName=ContinueRow}"/>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="ContinueRow" Style="{StaticResource RowScroll}" PreviewMouseWheel="Row_Wheel"
                      Visibility="{Binding ContinueGames.Count, Converter={StaticResource CountVis}}">
          <ItemsControl ItemsSource="{Binding ContinueGames}" ItemTemplate="{StaticResource GameTileTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>

        <!-- recommended -->
        <Grid Margin="2,26,0,10">
          <TextBlock Text="Recommended for you" FontSize="18" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="30" Height="30" Click="ScrollLeft_Click" Tag="{Binding ElementName=RecRow}"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="30" Height="30" Margin="0" Click="ScrollRight_Click" Tag="{Binding ElementName=RecRow}"/>
          </StackPanel>
        </Grid>
        <ctl:StateView State="{Binding GamesLoad.State}" Message="{Binding GamesLoad.Message}" MinHeight="200"
                       EmptyText="Roblox has no recommendations for this account yet." RetryCommand="{Binding RefreshHomeCommand}">
          <ScrollViewer x:Name="RecRow" Style="{StaticResource RowScroll}" PreviewMouseWheel="Row_Wheel">
            <ItemsControl ItemsSource="{Binding RecommendedGames}" ItemTemplate="{StaticResource GameTileTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </ctl:StateView>
      </StackPanel>

      <!-- shortcuts -->
      <UniformGrid Columns="3" Margin="0,28,0,0">
        <Button Margin="0,0,12,0" HorizontalContentAlignment="Left" Padding="20,18"
                Command="{Binding GoMultiTabCommand}" CommandParameter="Running">
          <StackPanel>
            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Accent}"/>
            <TextBlock Margin="0,10,0,2" FontSize="22" FontWeight="Bold">
              <Run Text="{Binding RunningCount, Mode=OneWay}"/><Run Text=" running" FontSize="14" FontWeight="Normal"/>
            </TextBlock>
            <TextBlock Text="Multi-launch: your alts and clients" Style="{StaticResource MutedText}" FontSize="12"/>
          </StackPanel>
        </Button>
        <Button Margin="0,0,12,0" HorizontalContentAlignment="Left" Padding="20,18"
                Command="{Binding GoMultiTabCommand}" CommandParameter="Accounts">
          <StackPanel>
            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Accent}"/>
            <TextBlock Margin="0,10,0,2" FontSize="22" FontWeight="Bold">
              <Run Text="{Binding AccountCount, Mode=OneWay}"/><Run Text=" accounts" FontSize="14" FontWeight="Normal"/>
            </TextBlock>
            <TextBlock Text="{Binding AccountsSubtitle, Mode=OneWay}" Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Button>
        <Button Margin="0" HorizontalContentAlignment="Left" Padding="20,18"
                Command="{Binding GoPageCommand}" CommandParameter="Performance">
          <StackPanel>
            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="{DynamicResource Accent}"/>
            <TextBlock Text="FPS &amp; FastFlags" Margin="0,10,0,2" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="FPS cap, graphics and performance" Style="{StaticResource MutedText}" FontSize="12"/>
          </StackPanel>
        </Button>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
