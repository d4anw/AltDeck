<UserControl x:Class="RoDeck.Views.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls">
  <UserControl.Resources>
    <!-- a row's header: title, refresh / scroll buttons -->
    <Style x:Key="RowScroll" TargetType="ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
      <!-- room above the cards inside the row, so a card that lifts on hover isn't cut off at the top -->
      <Setter Property="Margin" Value="0,-6,0,0"/>
      <Style.Resources>
        <Style TargetType="ItemsControl"><Setter Property="Margin" Value="0,6,0,0"/></Style>
      </Style.Resources>
    </Style>
    <Style x:Key="HomeStat" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="16" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}"
                    BorderThickness="1" Padding="18,16,18,16">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLine}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,26,32,32">

      <!-- ================= greeting ================= -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="60" Height="60">
          <Ellipse Fill="{DynamicResource AccentSoft}" Stroke="{DynamicResource Accent}" StrokeThickness="2"/>
          <ctl:AvatarView Width="52" Height="52" Url="{Binding CurrentAccount.AvatarUrl}" Initials="{Binding CurrentAccount.Initials}"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="28" FontWeight="Bold" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding Greeting, Mode=OneWay}"/><Run Text=","/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue=there, TargetNullValue=there}"/>
          </TextBlock>
          <TextBlock Margin="0,2,0,0" Style="{StaticResource MutedText}"
                     Text="{Binding CurrentAccount.Username, Mode=OneWay, StringFormat='@{0}', FallbackValue='Add an account to get started.'}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Refresh Home" Margin="0"
                  Command="{Binding RefreshHomeCommand}"
                  Visibility="{Binding HasCurrentAccount, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
      </Grid>

      <!-- no account yet -->
      <Border Style="{StaticResource CardBox}" Margin="0,22,0,0" Padding="28,26"
              Visibility="{Binding HasCurrentAccount, Converter={StaticResource BoolVisInv}}">
        <StackPanel>
          <TextBlock Text="Welcome to RoDeck" FontSize="22" FontWeight="Bold"/>
          <TextBlock Margin="0,6,0,16" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="Add your first Roblox account to see your friends, games, avatar and trades here. Sign in through a browser window, paste cookies, or import a file. Everything stays encrypted on this PC."/>
          <Button Content="Add an account" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0" Padding="20,11"
                  Command="{Binding GoMultiTabCommand}" CommandParameter="Accounts"/>
        </StackPanel>
      </Border>

      <!-- ================= banner + live numbers ================= -->
      <!-- its height follows the width only a little (320 to 440, set in code): the picture fills it (cropped) instead of
           growing with the window, and the four cards beside it keep a good shape -->
      <Grid x:Name="HeroRow" Margin="0,22,0,0" Height="340" Visibility="{Binding HasCurrentAccount, Converter={StaticResource BoolVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*" MinWidth="320" MaxWidth="560"/>
        </Grid.ColumnDefinitions>

        <!-- the last game you played, big, with Play right on it -->
        <Border CornerRadius="18" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
          <Grid>
            <ctl:RemoteImage Url="{Binding HeroImage}" CornerRadius="17"/>
            <!-- darker towards the bottom left, so the text stays readable on any picture (only when there is one) -->
            <Border CornerRadius="17" Visibility="{Binding HasHeroGame, Converter={StaticResource BoolVis}}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0.9,0">
                  <GradientStop Color="#F00B0C0E" Offset="0"/>
                  <GradientStop Color="#990B0C0E" Offset="0.5"/>
                  <GradientStop Color="#100B0C0E" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Bottom" Margin="26,0,26,24" Visibility="{Binding HasHeroGame, Converter={StaticResource BoolVis}}">
              <TextBlock Text="{Binding HeroCaption}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
              <TextBlock Text="{Binding HeroGame.Name}" FontSize="28" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>
              <TextBlock Text="{Binding HeroGame.PlayingText}" Foreground="#CCFFFFFF" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{StaticResource Primary}" Padding="22,11" Command="{Binding PlayGameCommand}" CommandParameter="{Binding HeroGame}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Play"/>
                  </StackPanel>
                </Button>
                <Button Content="Game page" Margin="0" Command="{Binding OpenGameCommand}" CommandParameter="{Binding HeroGame}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasHeroGame, Converter={StaticResource BoolVisInv}}">
              <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
              <TextBlock Text="Your games show up here" Margin="0,10,0,10" HorizontalAlignment="Center" Style="{StaticResource MutedText}"/>
              <Button Content="Browse games" HorizontalAlignment="Center" Margin="0" Command="{Binding GoPageCommand}" CommandParameter="Games"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- live numbers; each opens its page. Icon top left, the number and what it is at the bottom: fills any height. -->
        <UniformGrid Grid.Column="2" Columns="2" Rows="2">
          <Button Style="{StaticResource HomeStat}" Margin="0,0,6,6" Command="{Binding OpenHomeCardCommand}" CommandParameter="Friends">
            <DockPanel>
              <Grid DockPanel.Dock="Top">
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                  <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,4,0,0" Style="{StaticResource MutedText}"/>
              </Grid>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontSize="34" FontWeight="Bold" Text="{Binding OnlineFriends.Count, Mode=OneWay}"/>
                <TextBlock Text="Friends online" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Who is playing now" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource HomeStat}" Margin="6,0,0,6" Command="{Binding OpenHomeCardCommand}" CommandParameter="Requests">
            <DockPanel>
              <Grid DockPanel.Dock="Top">
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                  <TextBlock Text="&#xE8FA;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,4,0,0" Style="{StaticResource MutedText}"/>
              </Grid>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontSize="34" FontWeight="Bold" Text="{Binding RequestCount, Mode=OneWay}"/>
                <TextBlock Text="Friend requests" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Accept or decline" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource HomeStat}" Margin="0,6,6,0" Command="{Binding OpenHomeCardCommand}" CommandParameter="Trades">
            <DockPanel>
              <Grid DockPanel.Dock="Top">
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                  <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,4,0,0" Style="{StaticResource MutedText}"/>
              </Grid>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontSize="34" FontWeight="Bold" Text="{Binding InboundCount, Mode=OneWay}"/>
                <TextBlock Text="Trades waiting" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Sent to this account" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
          <Button Style="{StaticResource HomeStat}" Margin="6,6,0,0" Command="{Binding OpenHomeCardCommand}" CommandParameter="Multi">
            <DockPanel>
              <Grid DockPanel.Dock="Top">
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left">
                  <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,4,0,0" Style="{StaticResource MutedText}"/>
              </Grid>
              <StackPanel VerticalAlignment="Bottom">
                <TextBlock FontSize="34" FontWeight="Bold" Text="{Binding RunningCount, Mode=OneWay}"/>
                <TextBlock Text="Clients running" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Multi-launch" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
          </Button>
        </UniformGrid>
      </Grid>

      <StackPanel Visibility="{Binding HasCurrentAccount, Converter={StaticResource BoolVis}}">

        <!-- friends online -->
        <Grid Margin="2,26,0,10">
          <TextBlock Text="{Binding FriendsTitle}" FontSize="20" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="30" Height="30" Click="ScrollLeft_Click" Tag="{Binding ElementName=FriendsRow}"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="30" Height="30" Margin="0" Click="ScrollRight_Click" Tag="{Binding ElementName=FriendsRow}"/>
          </StackPanel>
        </Grid>
        <ctl:StateView State="{Binding FriendsLoad.State}" Message="{Binding FriendsLoad.Message}" MinHeight="120"
                       EmptyText="None of this account's friends are online right now." RetryCommand="{Binding RefreshHomeCommand}">
          <ScrollViewer x:Name="FriendsRow" Style="{StaticResource RowScroll}" PreviewMouseWheel="Row_Wheel">
            <ItemsControl ItemsSource="{Binding OnlineFriends}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="104" Margin="0,0,10,0" Padding="6,10" Cursor="Hand"
                          Click="Friend_Click" MouseRightButtonUp="Friend_RightClick">
                    <Button.ToolTip>
                      <TextBlock>
                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" (@"/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=")"/>
                        <LineBreak/><Run Text="{Binding StatusText, Mode=OneWay}"/>
                      </TextBlock>
                    </Button.ToolTip>
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                      <Grid Width="64" Height="64" HorizontalAlignment="Center">
                        <ctl:AvatarView Url="{Binding HeadshotUrl}" Initials="{Binding Initials}"/>
                        <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                BorderThickness="3" BorderBrush="{DynamicResource Page}"
                                Background="{Binding StatusKind, Converter={StaticResource StatusBrush}}"/>
                        <!-- favourite friend -->
                        <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-4,-4,0,0" Background="{DynamicResource Accent}"
                                Visibility="{Binding IsFavourite, Converter={StaticResource BoolVis}}" ToolTip="Favourite friend">
                          <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource AccentFg}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding Label}" Margin="0,8,0,0" HorizontalAlignment="Center" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" MaxWidth="92"/>
                      <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis"
                                 MaxWidth="92" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </ctl:StateView>

        <!-- continue playing -->
        <Grid Margin="2,26,0,10" Visibility="{Binding ContinueGames.Count, Converter={StaticResource CountVis}}">
          <TextBlock Text="Continue playing" FontSize="20" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="30" Height="30" Click="ScrollLeft_Click" Tag="{Binding ElementName=ContinueRow}"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="30" Height="30" Margin="0" Click="ScrollRight_Click" Tag="{Binding ElementName=ContinueRow}"/>
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="ContinueRow" Style="{StaticResource RowScroll}" PreviewMouseWheel="Row_Wheel"
                      Visibility="{Binding ContinueGames.Count, Converter={StaticResource CountVis}}">
          <ItemsControl ItemsSource="{Binding ContinueGames}" ItemTemplate="{StaticResource GameTileTemplate}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>

        <!-- recommended -->
        <Grid Margin="2,26,0,10">
          <TextBlock Text="Recommended for you" FontSize="20" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource IconBtn}" Content="&#xE76B;" Width="30" Height="30" Click="ScrollLeft_Click" Tag="{Binding ElementName=RecRow}"/>
            <Button Style="{StaticResource IconBtn}" Content="&#xE76C;" Width="30" Height="30" Margin="0" Click="ScrollRight_Click" Tag="{Binding ElementName=RecRow}"/>
          </StackPanel>
        </Grid>
        <ctl:StateView State="{Binding GamesLoad.State}" Message="{Binding GamesLoad.Message}" MinHeight="200"
                       EmptyText="Roblox has no recommendations for this account yet." RetryCommand="{Binding RefreshHomeCommand}">
          <ScrollViewer x:Name="RecRow" Style="{StaticResource RowScroll}" PreviewMouseWheel="Row_Wheel">
            <ItemsControl ItemsSource="{Binding RecommendedGames}" ItemTemplate="{StaticResource GameTileTemplate}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </ctl:StateView>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
