<UserControl x:Class="RoDeck.Views.AvatarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls">
  <UserControl.Resources>
    <!-- a chip that lights up when selected (wardrobe categories, body parts) -->
    <Style x:Key="PickChip" TargetType="Button" BasedOn="{StaticResource Chip}">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Focusable" Value="False"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- an item: picture + name. Orange border and a tick when worn. Click: put on / take off. -->
    <DataTemplate x:Key="ItemTile">
      <Button Width="118" Margin="0,0,10,10" Padding="0" Cursor="Hand" Focusable="False" ToolTip="{Binding Name}"
              Command="{Binding DataContext.ToggleWearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1.5" CornerRadius="14">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-3" Duration="0:0:0.12"/>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.16"/>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <DataTrigger Binding="{Binding IsWorn}" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.5"/></DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <Grid>
          <StackPanel>
            <ctl:RemoteImage Url="{Binding ThumbUrl}" Height="104" Margin="6,6,6,0" CornerRadius="10" Background="Transparent" Stretch="Uniform"/>
            <TextBlock Text="{Binding Name}" Margin="9,6,9,9" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Accent}" Margin="0,6,6,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding IsWorn, Converter={StaticResource BoolVis}}">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource AccentFg}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32,26,32,32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="26"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ================= left: the avatar ================= -->
      <StackPanel>
        <Grid>
          <StackPanel>
            <TextBlock Text="Avatar" FontSize="28" FontWeight="Bold"/>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}">
              <Run Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue='No account'}"/><Run Text="  ·  "/><Run Text="{Binding AvatarSummary, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
          <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"
                  ToolTip="Refresh" Command="{Binding RefreshAvatarCommand}"/>
        </Grid>

        <ctl:StateView State="{Binding AvatarLoad.State}" Message="{Binding AvatarLoad.Message}" MinHeight="340" Margin="0,16,0,0"
                       EmptyText="Pick an account top right." RetryCommand="{Binding RefreshAvatarCommand}">
          <StackPanel>
            <!-- preview: a 3D model you can turn (drag), or Roblox's picture -->
            <Border Height="380" CornerRadius="20" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" ClipToBounds="True">
              <Grid>
                <ctl:RemoteImage Url="{Binding AvatarPicture}" CornerRadius="19" Background="Transparent" Stretch="Uniform" Margin="10"
                                 Visibility="{Binding Showing3D, Converter={StaticResource BoolVisInv}}"/>
                <ctl:Avatar3DView Avatar="{Binding Avatar3DShown}" Paused="{Binding IsAdjusting}" Margin="4"
                                  Visibility="{Binding Showing3D, Converter={StaticResource BoolVis}}"/>

                <!-- 3D / picture switch -->
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Padding="10,5" Focusable="False"
                        Command="{Binding TogglePreview3DCommand}" Visibility="{Binding AvatarLook, Converter={StaticResource NullCollapsed}}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                      <Setter Property="Content" Value="Picture"/>
                      <Setter Property="ToolTip" Value="Show Roblox's picture instead"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Show3D}" Value="False">
                          <Setter Property="Content" Value="3D"/>
                          <Setter Property="ToolTip" Value="Turn the avatar around in 3D (loads the 3D model)"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <TextBlock Text="Drag to turn" FontSize="11" Style="{StaticResource MutedText}" Margin="14,0,0,12"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"
                           Visibility="{Binding Showing3D, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Preview3DNote}" FontSize="11" Style="{StaticResource MutedText}" Margin="14,0,14,12"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False" TextWrapping="Wrap"
                           Visibility="{Binding Showing3D, Converter={StaticResource BoolVisInv}}"/>

                <!-- Roblox is drawing the new look -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Padding="12,5" CornerRadius="10"
                        Background="{DynamicResource Card2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" IsHitTestVisible="False"
                        Visibility="{Binding PreviewUpdating, Converter={StaticResource BoolVis}}">
                  <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="40" Height="3" BorderThickness="0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" Margin="0,0,8,0"/>
                    <TextBlock Text="Updating preview…" FontSize="11"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Content="R6" Width="72" Padding="0,8" Margin="0" HorizontalContentAlignment="Center" Focusable="False" Command="{Binding SetAvatarTypeCommand}" CommandParameter="R6">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsR15}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                          <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <Button Content="R15" Width="72" Padding="0,8" Margin="8,0,0,0" HorizontalContentAlignment="Center" Focusable="False" Command="{Binding SetAvatarTypeCommand}" CommandParameter="R15">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsR15}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </StackPanel>
              <Button x:Name="CopyBtn" Content="Copy look to…" HorizontalAlignment="Right" Margin="0" Click="CopyLook_Click"
                      ToolTip="Put this exact look on another of your accounts"/>
            </Grid>

            <Grid Margin="0,22,0,4">
              <TextBlock Text="Wearing" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding WornItems.Count}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
            </Grid>
            <TextBlock FontSize="12" Style="{StaticResource MutedText}" Margin="0,0,0,10" TextWrapping="Wrap">
              <Run Text="Click an item to take it off."/>
              <Run Text="&#xE713;" FontFamily="{StaticResource Icons}"/><Run Text=" adjusts a hat or accessory: move, turn or resize it."/>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding WornItems}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Width="78" Height="78" Margin="0,0,8,8">
                    <!-- the item: click takes it off -->
                    <Button Padding="0" Cursor="Hand" Focusable="False" ToolTip="{Binding Name, StringFormat='Take off {0}'}"
                            Command="{Binding DataContext.TakeOffWornCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="b" Background="{DynamicResource CardGrad}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1.5" CornerRadius="14">
                            <Grid>
                              <ContentPresenter/>
                              <Border x:Name="x" Background="#B8000000" CornerRadius="12" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="White" HorizontalAlignment="Center"/>
                                  <TextBlock Text="Take off" FontSize="10" Foreground="White" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                            </Grid>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="x" Property="Visibility" Value="Visible"/></Trigger>
                            <DataTrigger Binding="{Binding IsBeingAdjusted}" Value="True">
                              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                              <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                      <ctl:RemoteImage Url="{Binding ThumbUrl}" Margin="7" CornerRadius="8" Background="Transparent" Stretch="Uniform"/>
                    </Button>
                    <!-- ⚙: adjust (only for items Roblox lets you adjust) -->
                    <Button Width="26" Height="26" Margin="0,-6,-6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                            Focusable="False" ToolTip="{Binding Name, StringFormat='Adjust {0}'}"
                            Visibility="{Binding IsAdjustable, Converter={StaticResource BoolVis}}"
                            Command="{Binding DataContext.AdjustWornCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="c" CornerRadius="13" Background="{DynamicResource Card2}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1.5">
                            <TextBlock x:Name="g" Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Fg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="c" Property="Background" Value="{DynamicResource Accent}"/>
                              <Setter TargetName="g" Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsBeingAdjusted}" Value="True">
                              <Setter TargetName="c" Property="Background" Value="{DynamicResource Accent}"/>
                              <Setter TargetName="c" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                              <Setter TargetName="g" Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            </DataTrigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ctl:StateView>
      </StackPanel>

      <!-- ================= right: wardrobe / body / outfits ================= -->
      <StackPanel Grid.Column="2" Visibility="{Binding AvatarLook, Converter={StaticResource NullCollapsed}}">
        <!-- adjusting one accessory: position, rotation, size within Roblox's limits -->
        <Border Margin="0,6,0,18" Padding="18" CornerRadius="18" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                Visibility="{Binding IsAdjusting, Converter={StaticResource BoolVis}}">
          <StackPanel>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource AccentSoft}">
                <ctl:RemoteImage Url="{Binding AdjustThumb}" Margin="5" CornerRadius="8" Background="Transparent" Stretch="Uniform"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                  <Run Text="Adjust"/> <Run Text="{Binding AdjustItem.Name, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="Move, turn and resize it within Roblox's limits. Saved to Roblox a moment after you let go."
                           FontSize="12" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding AdjustLiveNote, Converter={StaticResource EmptyCollapsed}}">
                  <Ellipse Width="7" Height="7" Fill="#3DD68C" VerticalAlignment="Center" Margin="0,0,7,0"/>
                  <TextBlock Text="{Binding AdjustLiveNote}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
              <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" VerticalAlignment="Top" Margin="0"
                      ToolTip="Close" Command="{Binding CloseAdjustCommand}"/>
            </Grid>
            <Border Style="{StaticResource CardBox}" Padding="18,12,18,10" Margin="0,0,0,10">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C2;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="Position" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Subtle}" Command="{Binding ResetAdjustGroupCommand}" CommandParameter="Position"
                            ToolTip="Put position back to normal">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Reset" FontSize="12"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Left / right" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding PosMin}" Maximum="{Binding PosMax}" Value="{Binding AdjPosX}"
                        VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AdjPosX, StringFormat='{}{0:+0.00;-0.00;0}'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Text="Up / down" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding PosMin}" Maximum="{Binding PosMax}" Value="{Binding AdjPosY}"
                        VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AdjPosY, StringFormat='{}{0:+0.00;-0.00;0}'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="2" Text="Forward / back" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding PosMin}" Maximum="{Binding PosMax}" Value="{Binding AdjPosZ}"
                        VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AdjPosZ, StringFormat='{}{0:+0.00;-0.00;0}'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Padding="18,12,18,10" Margin="0,0,0,10">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="Rotation" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Subtle}" Command="{Binding ResetAdjustGroupCommand}" CommandParameter="Rotation"
                            ToolTip="Put rotation back to normal">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Reset" FontSize="12"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Tilt" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding RotXMin}" Maximum="{Binding RotXMax}" Value="{Binding AdjRotX}"
                        VerticalAlignment="Center" SmallChange="1" LargeChange="5" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AdjRotX, StringFormat='{}{0:+0;-0;0}°'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Text="Turn" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding RotMin}" Maximum="{Binding RotMax}" Value="{Binding AdjRotY}"
                        VerticalAlignment="Center" SmallChange="1" LargeChange="5" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AdjRotY, StringFormat='{}{0:+0;-0;0}°'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="2" Text="Lean" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding RotMin}" Maximum="{Binding RotMax}" Value="{Binding AdjRotZ}"
                        VerticalAlignment="Center" SmallChange="1" LargeChange="5" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AdjRotZ, StringFormat='{}{0:+0;-0;0}°'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBox}" Padding="18,12,18,10" Margin="0,0,0,10">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE740;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <TextBlock Text="Size" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Keep proportions" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding KeepProportions}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource Subtle}" Command="{Binding ResetAdjustGroupCommand}" CommandParameter="Size"
                            ToolTip="Put size back to normal">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Reset" FontSize="12"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="34"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Width" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="0" Grid.Column="1" Minimum="{Binding ScaleMin}" Maximum="{Binding ScaleMax}" Value="{Binding AdjScaleX}"
                        VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AdjScaleX, StringFormat='{}{0:P0}'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Text="Height" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding ScaleMin}" Maximum="{Binding ScaleMax}" Value="{Binding AdjScaleY}"
                        VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AdjScaleY, StringFormat='{}{0:P0}'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="2" Text="Depth" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding ScaleMin}" Maximum="{Binding ScaleMax}" Value="{Binding AdjScaleZ}"
                        VerticalAlignment="Center" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource FineSlider}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AdjScaleZ, StringFormat='{}{0:P0}'}" VerticalAlignment="Center"
                           HorizontalAlignment="Right" FontFamily="Consolas"/>
                </Grid>
              </StackPanel>
            </Border>
            <Grid Margin="0,6,0,0">
              <Button HorizontalAlignment="Left" Margin="0" Command="{Binding TakeOffAdjustingCommand}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Text="Take off"/>
                </StackPanel>
              </Button>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset all" Command="{Binding ResetAdjustCommand}" ToolTip="Back to how the item normally sits"/>
                <Button Content="Done" Style="{StaticResource Primary}" Margin="0" Padding="22,9" Command="{Binding CloseAdjustCommand}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,18">
          <RadioButton Style="{StaticResource Seg}" Content="Wardrobe" GroupName="avatartab"
                       IsChecked="{Binding AvatarTab, Converter={StaticResource Eq}, ConverterParameter=Wardrobe, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Seg}" Content="Body" GroupName="avatartab"
                       IsChecked="{Binding AvatarTab, Converter={StaticResource Eq}, ConverterParameter=Body, Mode=TwoWay}"/>
          <RadioButton Style="{StaticResource Seg}" Content="Outfits" GroupName="avatartab" Margin="0"
                       IsChecked="{Binding AvatarTab, Converter={StaticResource Eq}, ConverterParameter=Outfits, Mode=TwoWay}"/>
        </StackPanel>

        <!-- wardrobe -->
        <StackPanel Visibility="{Binding AvatarTab, Converter={StaticResource PageVis}, ConverterParameter=Wardrobe}">
          <ItemsControl ItemsSource="{Binding WardrobeChips}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource PickChip}" Content="{Binding Name}"
                        Command="{Binding DataContext.SelectWardrobeCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ctl:SearchBox Width="300" HorizontalAlignment="Left" Margin="0,6,0,14" Text="{Binding WardrobeFilter}" Placeholder="Filter these items"/>
          <ctl:StateView State="{Binding WardrobeLoad.State}" Message="{Binding WardrobeLoad.Message}" MinHeight="220"
                         EmptyText="This account has no items of this kind." RetryCommand="{Binding RefreshAvatarCommand}">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding WardrobeItems}" ItemTemplate="{StaticResource ItemTile}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              </ItemsControl>
              <Button Content="Load more" HorizontalAlignment="Left" Margin="0,4,0,0" Command="{Binding LoadMoreWardrobeCommand}"
                      Visibility="{Binding HasMoreWardrobe, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </ctl:StateView>
        </StackPanel>

        <!-- body -->
        <StackPanel Visibility="{Binding AvatarTab, Converter={StaticResource PageVis}, ConverterParameter=Body}">
          <Border Style="{StaticResource CardBox}" Padding="22,18">
            <StackPanel>
              <TextBlock Text="Skin colour" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="Pick a body part (or the whole body), then a colour." FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,12"/>
              <WrapPanel>
                <Button Content="Whole body" Command="{Binding SelectBodyPartCommand}" CommandParameter="all" Margin="0,0,8,8" Focusable="False">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AllPartsSelected}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                          <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
                <ItemsControl ItemsSource="{Binding BodyParts}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource PickChip}"
                              Command="{Binding DataContext.SelectBodyPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding Key}">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="14" Height="14" CornerRadius="7" Margin="0,0,8,0" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                  Background="{Binding Hex, Converter={StaticResource HexBrush}}"/>
                          <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>
              <ItemsControl ItemsSource="{Binding SkinPalette}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="34" Height="34" Margin="0,0,6,6" Cursor="Hand" Focusable="False" ToolTip="{Binding Name}"
                            Command="{Binding DataContext.PickSkinColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Hex}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="b" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                                  Background="{Binding Hex, Converter={StaticResource HexBrush}}"/>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Fg}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}" Padding="22,18" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Body scale" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock FontSize="12" Margin="0,2,0,12" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                    <Setter Property="Text" Value="Only R15 avatars can change their scale. Switch to R15 on the left."/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsR15}" Value="True"><Setter Property="Text" Value="Drag the sliders, then Save."/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Grid IsEnabled="{Binding IsR15}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Height" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="{Binding HeightMin}" Maximum="{Binding HeightMax}" Value="{Binding ScaleHeight}" VerticalAlignment="Center"
                        SmallChange="0.01" LargeChange="0.05" Style="{StaticResource PerfSlider}"/>
                <TextBlock Grid.Column="2" Text="{Binding ScaleHeight, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="1" Text="Width" VerticalAlignment="Center"/>
                <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding WidthMin}" Maximum="{Binding WidthMax}" Value="{Binding ScaleWidth}" VerticalAlignment="Center"
                        SmallChange="0.01" LargeChange="0.05" Style="{StaticResource PerfSlider}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ScaleWidth, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="2" Text="Head" VerticalAlignment="Center"/>
                <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding HeadMin}" Maximum="{Binding HeadMax}" Value="{Binding ScaleHead}" VerticalAlignment="Center"
                        SmallChange="0.01" LargeChange="0.05" Style="{StaticResource PerfSlider}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ScaleHead, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="3" Text="Proportions" VerticalAlignment="Center"/>
                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScaleProportion}" VerticalAlignment="Center"
                        SmallChange="0.01" LargeChange="0.1" Style="{StaticResource PerfSlider}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ScaleProportion, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
                <TextBlock Grid.Row="4" Text="Body type" VerticalAlignment="Center"/>
                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ScaleBodyType}" VerticalAlignment="Center"
                        SmallChange="0.01" LargeChange="0.1" Style="{StaticResource PerfSlider}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding ScaleBodyType, StringFormat='{}{0:P0}'}" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
              </Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                          Visibility="{Binding ScalesChanged, Converter={StaticResource BoolVis}}">
                <Button Content="Undo" Command="{Binding ResetScalesCommand}"/>
                <Button Content="Save" Style="{StaticResource Primary}" Margin="0" Command="{Binding ApplyScalesCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- outfits -->
        <StackPanel Visibility="{Binding AvatarTab, Converter={StaticResource PageVis}, ConverterParameter=Outfits}">
          <Grid Margin="0,0,0,14">
            <TextBlock Text="Click an outfit to wear it. Right-click to rename or delete." Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <Button Content="+ Save current look" Style="{StaticResource Primary}" HorizontalAlignment="Right" Margin="0"
                    Command="{Binding SaveOutfitCommand}"/>
          </Grid>
          <ctl:StateView State="{Binding OutfitsLoad.State}" Message="{Binding OutfitsLoad.Message}" MinHeight="220"
                         EmptyText="No outfits yet. Save the current look to make one.">
            <ItemsControl ItemsSource="{Binding Outfits}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="140" Margin="0,0,12,12" Padding="0" Cursor="Hand" Focusable="False" ToolTip="{Binding Name, StringFormat='Wear {0}'}"
                          Command="{Binding DataContext.WearOutfitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}" MouseRightButtonUp="Outfit_RightClick">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                      <ctl:RemoteImage Url="{Binding ThumbUrl}" Height="126" Margin="7,7,7,0" CornerRadius="10" Background="Transparent" Stretch="Uniform"/>
                      <TextBlock Text="{Binding Name}" Margin="10,6,10,10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ctl:StateView>
        </StackPanel>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
