<UserControl x:Class="RoDeck.Views.BuyCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls">
  <Grid Visibility="{Binding ShowDealBuy, Converter={StaticResource BoolVis}}" Background="#B0000000">
    <Border Style="{StaticResource CardBox}" Width="440" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource Card}">
      <StackPanel>
        <TextBlock Text="Buy this item?" FontSize="20" FontWeight="Bold"/>
        <Grid Margin="0,16,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="72" Height="72" CornerRadius="12" Background="{DynamicResource Card2}">
            <ctl:RemoteImage Url="{Binding DealBuyDeal.ThumbUrl}" CornerRadius="12"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding DealBuyDeal.Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding DealBuyDeal.DetailText}" FontSize="12" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="28"/></Grid.RowDefinitions>
          <TextBlock Text="Price" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding DealBuyPriceText}" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Text="Account" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentAccount.Label}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Row="2" Text="Robux" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DealBuyAfterText}" VerticalAlignment="Center" FontFamily="Consolas"/>
          <TextBlock Grid.Row="3" Text="Seller" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DealBuySellerText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <TextBlock Text="{Binding DealBuyChangedText}" Foreground="{DynamicResource Gold}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding DealBuyChangedText, Converter={StaticResource EmptyCollapsed}}"/>
        <TextBlock Text="{Binding DealBuyError}" Foreground="{DynamicResource Red}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding DealBuyError, Converter={StaticResource EmptyCollapsed}}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button Content="View item" Command="{Binding ViewDealCommand}" CommandParameter="{Binding DealBuyDeal}" Click="DealBuyView_Click"
                  Visibility="{Binding DealBuyFromDeals, Converter={StaticResource BoolVis}}"/>
          <Button Content="Cancel" Command="{Binding CancelDealBuyCommand}" IsCancel="True"/>
          <Button Margin="0" Style="{StaticResource Primary}" Content="{Binding ConfirmDealBuyText}" Command="{Binding ConfirmDealBuyCommand}"
                  IsEnabled="{Binding CanConfirmDealBuy}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
