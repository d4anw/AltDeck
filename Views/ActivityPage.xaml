<UserControl x:Class="AltDeck.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="32,26,32,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Activity" FontSize="28" FontWeight="Bold"/>
      <TextBlock Margin="0,4,0,18" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                 Text="Everything AltDeck did: launches, drops, rejoins, give-ups, frozen restarts and sign-in problems. Also saved to a file each day (kept 14 days) — copy it when you report a bug."/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <RadioButton Style="{StaticResource Seg}" Content="All" GroupName="logfilter"
                     IsChecked="{Binding LogFilter, Converter={StaticResource Eq}, ConverterParameter=All, Mode=TwoWay}"/>
        <RadioButton Style="{StaticResource Seg}" Content="Problems only" GroupName="logfilter" Margin="0"
                     IsChecked="{Binding LogFilter, Converter={StaticResource Eq}, ConverterParameter=Problems, Mode=TwoWay}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Copy" Command="{Binding CopyLogCommand}" ToolTip="Copy the lines shown, oldest first"/>
        <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}"/>
        <Button Content="Clear list" Command="{Binding ClearLogCommand}" ToolTip="Empties this list. The files are kept."/>
        <Button Content="Report a bug" Margin="0" Command="{Binding ReportBugCommand}"
                ToolTip="Opens a bug report on GitHub and copies this log so you can paste it in"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource CardBox}" Padding="6">
      <Grid>
        <ItemsControl ItemsSource="{Binding LogView}" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
          <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter/>
              </ScrollViewer>
            </ControlTemplate>
          </ItemsControl.Template>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TimeText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" Style="{StaticResource MutedText}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Kind, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{Binding Kind, Converter={StaticResource LogBrush}}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Message, Mode=OneWay}" TextWrapping="Wrap"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Nothing yet. Launch some accounts and it shows up here." HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding LogView.IsEmpty}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </Grid>
    </Border>
  </Grid>
</UserControl>
