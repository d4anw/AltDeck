<UserControl x:Class="RoDeck.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:RoDeck.Controls">
  <Grid Margin="32,26,32,28">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="24"/>
      <ColumnDefinition Width="340"/>
    </Grid.ColumnDefinitions>

    <!-- ===== list side ===== -->
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Accounts" FontSize="28" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding AccountsSubtitle, Mode=OneWay}" Style="{StaticResource MutedText}"/>
            <TextBlock Text=" · " Style="{StaticResource MutedText}"
                       Visibility="{Binding NeedsSignInText, Converter={StaticResource EmptyCollapsed}}"/>
            <TextBlock Text="{Binding NeedsSignInText, Mode=OneWay}" Foreground="{DynamicResource Blue}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Command="{Binding CheckAllCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Check all sign-ins"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Primary}" Margin="0" Click="AddAccount_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Add account"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- filters -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,16">
        <ctl:SearchBox Width="290" Margin="0,0,10,0" Text="{Binding SearchText}" Placeholder="Filter by name, @user, id"/>
        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding StatusFilter}" MinWidth="140" Margin="0,0,10,0"/>
        <Button Content="All" Margin="0,0,8,0" Command="{Binding SetGroupCommand}" CommandParameter="">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource Chip}">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsAllActive}" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <ItemsControl ItemsSource="{Binding GroupChips}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="0,0,8,0"
                      Command="{Binding DataContext.SetGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding Name}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource Chip}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                           Fill="{Binding Name, Converter={StaticResource GroupBrush}}"/>
                  <TextBlock Text="{Binding Name}"/>
                  <TextBlock Text="{Binding Count}" Margin="8,0,0,0" Style="{StaticResource MutedText}"/>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- table -->
      <Border Grid.Row="2" Style="{StaticResource CardBox}" Padding="14,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="8,6,8,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition Width="*" MinWidth="170"/>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="170"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding AllVisibleSelected}"/>
            <TextBlock Grid.Column="1" Text="Account" FontSize="12" Style="{StaticResource MutedText}"/>
            <TextBlock Grid.Column="2" Text="Status" FontSize="12" Style="{StaticResource MutedText}"/>
            <TextBlock Grid.Column="3" Text="Robux" FontSize="12" Style="{StaticResource MutedText}"/>
            <TextBlock Grid.Column="4" Text="Groups" FontSize="12" Style="{StaticResource MutedText}"/>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding AccountsView}" SelectedItem="{Binding SelectedAccount}"
                   Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Row}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*" MinWidth="170"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                  <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ctl:AvatarView Width="34" Height="34" Margin="0,0,12,0" Url="{Binding AvatarUrl}" Initials="{Binding Initials}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"
                                 ToolTip="{Binding Label, Mode=OneWay}"/>
                      <TextBlock FontSize="11" FontFamily="Consolas" Style="{StaticResource MutedText}"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Username, Mode=OneWay, StringFormat='@{0}'}"
                                 ToolTip="{Binding Username, Mode=OneWay, StringFormat='@{0}'}"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}"/>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="110"
                               ToolTip="{Binding StatusText, Mode=OneWay}"/>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding RobuxText, Mode=OneWay}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" ToolTip="{Binding RobuxText, Mode=OneWay}" Margin="0,0,20,0"/>
                  <ItemsControl Grid.Column="4" ItemsSource="{Binding GroupList}" VerticalAlignment="Center" ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource Card2}" CornerRadius="8" Padding="8,2" Margin="0,0,6,0">
                          <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{Binding Converter={StaticResource GroupBrush}}"/>
                            <TextBlock Text="{Binding}" FontSize="11"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Grid.Column="5" Content="{Binding StarGlyph}"
                          Command="{Binding DataContext.ToggleFavouriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsFavourite}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button Grid.Column="6" Style="{StaticResource IconBtn}" Content="&#xE768;" Margin="0"
                          Visibility="{Binding IsPlaying, Converter={StaticResource BoolVisInv}}"
                          Command="{Binding DataContext.PlayOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="{Binding Settings.Density, StringFormat='Density: {0}'}" FontSize="11"
                     Margin="8,8,0,0" Style="{StaticResource MutedText}"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ===== detail side ===== -->
    <Grid Grid.Column="2" Visibility="{Binding SelectedAccount, Converter={StaticResource NullCollapsed}}">
      <Border DataContext="{Binding SelectedAccount}" Style="{StaticResource CardBox}" Padding="24" VerticalAlignment="Top">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <ctl:AvatarView Width="68" Height="68" Url="{Binding AvatarUrl}" Initials="{Binding Initials}"/>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Label, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Fg}"
                         TextTrimming="CharacterEllipsis" MaxWidth="200" ToolTip="{Binding Label, Mode=OneWay}"/>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock FontFamily="Consolas" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="170"
                           Text="{Binding Username, Mode=OneWay, StringFormat='@{0}'}"
                           ToolTip="{Binding Username, Mode=OneWay, StringFormat='@{0}'}"/>
                <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="26" Height="26" FontSize="11"
                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Username}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="Consolas" FontSize="12" Style="{StaticResource MutedText}" VerticalAlignment="Center">
                  <Run Text="ID "/><Run Text="{Binding UserId, Mode=OneWay}"/>
                </TextBlock>
                <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" Width="26" Height="26" FontSize="11"
                        Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding UserId}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding RobuxText, Mode=OneWay}" Margin="0,14,0,0" FontWeight="SemiBold"
                     Foreground="{DynamicResource Accent}"
                     Visibility="{Binding RobuxText, Converter={StaticResource EmptyCollapsed}}"/>
          <Grid Margin="0,18,0,14">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                       Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}"/>
              <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" Foreground="{DynamicResource Fg}"/>
            </StackPanel>
            <TextBlock Text="{Binding CheckedText, Mode=OneWay}" FontSize="11" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
          </Grid>

          <!-- one button: "Play", or a disabled "Already playing" while this account has a client running -->
          <Button HorizontalAlignment="Stretch" Margin="0,0,0,10"
                  Command="{Binding DataContext.PlayOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                <Setter Property="Content">
                  <Setter.Value>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                      <TextBlock Text="Play"/>
                    </StackPanel>
                  </Setter.Value>
                </Setter>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="Already playing"/>
                    <Setter Property="IsEnabled" Value="False"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="Check sign-in" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                  Command="{Binding DataContext.CheckOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}"/>

          <ctl:SettingRow Title="Full quality"
                          Description="For your main account: keeps your own Roblox graphics instead of the lighter performance profile.">
            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding FullQuality}"/>
          </ctl:SettingRow>
          <ctl:SettingRow Title="Bring it back if it drops"
                          Description="{Binding DataContext.BringBackNote, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BringBack}"/>
          </ctl:SettingRow>

          <Button Style="{StaticResource Subtle}" Content="More details  &#x25BE;" HorizontalAlignment="Center" Margin="0,10,0,0"
                  Click="MoreDetails_Click"/>
          <StackPanel x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Alias" FontSize="12" Margin="0,0,0,4" Style="{StaticResource MutedText}"/>
            <TextBox Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Groups (comma separated)" FontSize="12" Margin="0,10,0,4" Style="{StaticResource MutedText}"/>
            <TextBox Text="{Binding Groups, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Launch arguments (only this account)" FontSize="12" Margin="0,10,0,4" Style="{StaticResource MutedText}"/>
            <TextBox Text="{Binding LaunchArgs, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
            <TextBlock Text="Notes" FontSize="12" Margin="0,10,0,4" Style="{StaticResource MutedText}"/>
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"/>
          </StackPanel>

          <Button Style="{StaticResource Danger}" HorizontalAlignment="Stretch" Margin="0,18,0,0"
                  Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Remove account"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
