<Window x:Class="AltDeck.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22">
    <TextBlock x:Name="Prompt" Margin="0,0,0,12" TextWrapping="Wrap"/>
    <TextBox x:Name="Keys" IsReadOnly="True" FontFamily="Consolas" Padding="10,8"
             ToolTip="Click here, then press the keys" PreviewKeyDown="Keys_PreviewKeyDown"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Red}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
    <Grid Margin="0,18,0,0">
      <Button Content="No hotkey" HorizontalAlignment="Left" Click="Clear_Click" Margin="0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True"/>
        <Button Content="OK" Style="{StaticResource Primary}" Click="Ok_Click" Margin="0"/>
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
