<Window x:Class="RoDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:RoDeck.Views"
        xmlns:ctl="clr-namespace:RoDeck.Controls"
        Icon="RoDeck.ico" Title="RoDeck" Width="1320" Height="820" MinWidth="1020" MinHeight="660"
        WindowStyle="None" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="TitleBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- the grey rounded buttons in the title bar: bell, Robux, account -->
    <Style x:Key="TitlePill" TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Pill}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource PillHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- pictures are shown smaller than they are: scale them smoothly (WPF's default is fast and jagged) -->
  <Grid x:Name="Root" RenderOptions.BitmapScalingMode="HighQuality">
    <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0.15" IsHitTestVisible="False"/>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== title bar ===== -->
      <Grid Grid.Row="0">
        <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
          <Grid Width="18" Height="18" Margin="0,0,10,0">
            <Rectangle Width="9" Height="9" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" RadiusX="2" RadiusY="2"/>
            <Rectangle Width="9" Height="9" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/>
            <Rectangle Width="7" Height="7" Fill="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" RadiusX="2" RadiusY="2"/>
          </Grid>
          <TextBlock Text="RoDeck" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- notifications: friend requests and trades waiting (the dot counts both) -->
          <Button x:Name="BellBtn" Style="{StaticResource TitlePill}" Width="34" Padding="0" Click="BellBtn_Click" ToolTip="Notifications">
            <Grid Width="34" Height="34">
              <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Badge}" Background="{DynamicResource Red}" Height="15" MinWidth="15" Padding="4,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0"
                      Visibility="{Binding BellCount, Converter={StaticResource CountVis}}">
                <TextBlock Text="{Binding BellCount}" Style="{StaticResource BadgeText}" FontSize="10" Foreground="White"/>
              </Border>
            </Grid>
          </Button>
          <!-- Robux of the account in use -->
          <Button Style="{StaticResource TitlePill}" Padding="9,0,12,0" Margin="8,0,0,0" ToolTip="Robux" Click="Robux_Click"
                  Visibility="{Binding CurrentAccount.RobuxShort, Converter={StaticResource EmptyCollapsed}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal">
              <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                <Canvas Width="20" Height="20">
                  <!-- a rounded hexagon with a square in the middle -->
                  <Path Stroke="{DynamicResource Fg}" StrokeThickness="2.2" StrokeLineJoin="Round"
                        Data="M10,1.6 L17.3,5.8 L17.3,14.2 L10,18.4 L2.7,14.2 L2.7,5.8 Z"/>
                  <Rectangle Canvas.Left="7.2" Canvas.Top="7.2" Width="5.6" Height="5.6" RadiusX="0.8" RadiusY="0.8" Fill="{DynamicResource Fg}"/>
                </Canvas>
              </Viewbox>
              <TextBlock Text="{Binding CurrentAccount.RobuxShort, Mode=OneWay}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <!-- the account the pages show: avatar and name. Click to switch, or for the account tools. -->
          <Button x:Name="AccountBtn" Style="{StaticResource TitlePill}" Click="AccountBtn_Click" Padding="3,0,11,0" Margin="8,0,10,0" ToolTip="Switch account">
            <StackPanel Orientation="Horizontal">
              <ctl:AvatarView Width="28" Height="28" Url="{Binding CurrentAccount.AvatarUrl}" Initials="{Binding CurrentAccount.Initials}"/>
              <TextBlock Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue='No account', TargetNullValue='No account'}"
                         FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Text="&#x25BC;" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource TitleBtn}" Content="&#xE921;" Click="Min_Click"/>
          <Button x:Name="MaxBtn" Style="{StaticResource TitleBtn}" Content="&#xE922;" Click="Max_Click"/>
          <Button Style="{StaticResource TitleBtn}" Content="&#xE8BB;" Click="Close_Click"/>
        </StackPanel>
      </Grid>

      <!-- ===== body ===== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="232"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Grid Margin="12,4,6,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="PLAY" FontSize="11" FontWeight="SemiBold" Margin="4,4,0,6" Style="{StaticResource MutedText}"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE80F;" GroupName="nav" Content="Home"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Home, Mode=TwoWay}"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE7FC;" GroupName="nav" Content="Games"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Games, Mode=TwoWay}"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE716;" GroupName="nav"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Friends, Mode=TwoWay}">
                <Grid>
                  <TextBlock Text="Friends" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" Background="{DynamicResource Red}"
                          ToolTip="Friend requests" Visibility="{Binding HasRequests, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding RequestCount}" Style="{StaticResource BadgeText}" Foreground="White"/>
                  </Border>
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE902;" GroupName="nav" Content="Communities"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Communities, Mode=TwoWay}"/>

              <TextBlock Text="AVATAR &amp; ITEMS" FontSize="11" FontWeight="SemiBold" Margin="4,18,0,6" Style="{StaticResource MutedText}"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE77B;" GroupName="nav" Content="Avatar"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Avatar, Mode=TwoWay}"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE719;" GroupName="nav" Content="Marketplace"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Marketplace, Mode=TwoWay}"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE8AB;" GroupName="nav" Content="Trades"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Trades, Mode=TwoWay}"/>

              <TextBlock Text="TOOLS" FontSize="11" FontWeight="SemiBold" Margin="4,18,0,6" Style="{StaticResource MutedText}"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE8FD;" GroupName="nav"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Multi, Mode=TwoWay}">
                <Grid>
                  <TextBlock Text="Multi-launch" VerticalAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,6,0" Cursor="Hand" VerticalAlignment="Center"
                            ToolTip="{Binding ExpiredSignInText}" Command="{Binding ShowNeedsSignInCommand}"
                            Visibility="{Binding HasExpiredSignIns, Converter={StaticResource BoolVis}}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border Style="{StaticResource Badge}" Background="{DynamicResource Red}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Border>
                        </ControlTemplate>
                      </Button.Template>
                      <TextBlock Style="{StaticResource BadgeText}" Foreground="White">
                        <Run Text="&#x26A0;"/><Run Text=" "/><Run Text="{Binding NeedsSignInCount, Mode=OneWay}"/>
                      </TextBlock>
                    </Button>
                    <Border Style="{StaticResource Badge}" ToolTip="Clients running">
                      <TextBlock Text="{Binding RunningCount}" Style="{StaticResource BadgeText}"/>
                    </Border>
                  </StackPanel>
                </Grid>
              </RadioButton>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE9D9;" GroupName="nav" Content="FPS &amp; FastFlags"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Performance, Mode=TwoWay}"/>
              <Border Height="1" Background="{DynamicResource Line}" Margin="4,14,4,10"/>
              <RadioButton Style="{StaticResource Nav}" Tag="&#xE713;" GroupName="nav" Content="Settings"
                           IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Settings, Mode=TwoWay}"/>
              <TextBlock Text="{Binding LockBadge, Mode=OneWay}" Margin="4,12,0,0" FontSize="12" Style="{StaticResource MutedText}"/>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal" Margin="6,12,0,0">
              <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"
                         Style="{StaticResource MutedText}"/>
              <TextBlock Text="Encrypted on this PC" FontSize="12" Margin="8,0,0,0" Style="{StaticResource MutedText}"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- page area -->
        <Border Grid.Column="1" Margin="0,2,12,12" CornerRadius="20" Background="{DynamicResource Page}"
                BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
          <Grid>
            <!-- a faint glow of the accent colour in the top corner -->
            <Border CornerRadius="20" Background="{DynamicResource PageGlow}" IsHitTestVisible="False"/>
            <Grid x:Name="PageHost">
              <Grid.RenderTransform><TranslateTransform x:Name="PageSlide"/></Grid.RenderTransform>
            <views:StartPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Home}"/>
            <views:GamesPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Games}"/>
            <views:AvatarPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Avatar}"/>
            <views:MarketplacePage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Marketplace}"/>
            <views:TradesPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Trades}"/>
            <views:FriendsPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Friends}"/>
            <views:MultiLaunchPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Multi}"/>
            <views:PerformancePage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Performance}"/>
            <views:SettingsPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Settings}"/>
            <views:TransactionsPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Transactions}"/>
            <views:CommunitiesPage Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Communities}"/>
            </Grid>

            <!-- a private server's settings (like roblox.com's Configure Private Server page), over any page -->
            <Grid Visibility="{Binding ShowServerConfig, Converter={StaticResource BoolVis}}" Background="#B0000000">
              <Border Style="{StaticResource CardBox}" Width="640" MaxHeight="720" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource Card}">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Margin="26,22,22,0">
                    <TextBlock Text="Private server settings" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0" ToolTip="Close"
                            Command="{Binding CloseServerConfigCommand}"/>
                  </Grid>
                  <ctl:StateView Grid.Row="1" State="{Binding ServerConfigLoad.State}" Message="{Binding ServerConfigLoad.Message}" MinHeight="260">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <StackPanel Margin="26,16,26,24">
                        <!-- the game, name, price -->
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <Grid Width="112" Height="112">
                            <Border CornerRadius="16" Background="{DynamicResource Card2}"/>
                            <ctl:RemoteImage Url="{Binding ConfigGameIcon}" CornerRadius="16"/>
                          </Grid>
                          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Name" FontSize="12" Style="{StaticResource MutedText}"/>
                            <Grid Margin="0,4,0,0">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBox Text="{Binding ConfigName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Padding="10,7"/>
                              <Button Grid.Column="1" Content="Save" Margin="8,0,0,0" Command="{Binding SaveConfigNameCommand}"/>
                            </Grid>
                            <TextBlock Margin="0,10,0,0" TextTrimming="CharacterEllipsis">
                              <Run Text="{Binding ConfigServer.GameName, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding ConfigPriceLine}" Margin="0,3,0,0" FontSize="12" Style="{StaticResource MutedText}"/>
                          </StackPanel>
                        </Grid>

                        <!-- joining -->
                        <Border Background="{DynamicResource Card2}" CornerRadius="14" Padding="16,12" Margin="0,18,0,0">
                          <Grid>
                            <StackPanel Margin="0,0,70,0">
                              <TextBlock Text="Allow joining" FontWeight="SemiBold"/>
                              <TextBlock FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" Style="{StaticResource MutedText}"
                                         Text="Off: nobody can join, you neither, and the current link stops working. You can turn it on again any time."/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding ConfigActive, Mode=OneWay}" Command="{Binding ToggleConfigActiveCommand}"/>
                          </Grid>
                        </Border>

                        <!-- renewing (paid servers) -->
                        <Border Background="{DynamicResource Card2}" CornerRadius="14" Padding="16,12" Margin="0,8,0,0"
                                Visibility="{Binding ConfigIsPaid, Converter={StaticResource BoolVis}}">
                          <Grid>
                            <StackPanel Margin="0,0,70,0">
                              <TextBlock Text="Renew every month" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding ConfigRenewText}" FontSize="12" Margin="0,3,0,0" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding ConfigRenewing, Mode=OneWay}" Command="{Binding ToggleConfigRenewingCommand}"/>
                          </Grid>
                        </Border>

                        <!-- who can join -->
                        <Border Background="{DynamicResource Card2}" CornerRadius="14" Padding="16,12" Margin="0,8,0,0">
                          <StackPanel>
                            <Grid>
                              <TextBlock Text="Friends allowed" FontWeight="SemiBold" VerticalAlignment="Center"/>
                              <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            IsChecked="{Binding ConfigFriendsAllowed, Mode=OneWay}" Command="{Binding ToggleConfigFriendsCommand}"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                              <StackPanel>
                                <TextBlock Text="Server members" FontWeight="SemiBold"/>
                                <TextBlock Text="None yet." FontSize="12" Margin="0,4,0,0" Style="{StaticResource MutedText}"
                                           Visibility="{Binding ConfigMembers.Count, Converter={StaticResource CountVis}, ConverterParameter=Inverse}"/>
                                <ItemsControl ItemsSource="{Binding ConfigMembers}" Margin="0,8,0,0">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ctl:AvatarView Width="32" Height="32" Url="{Binding HeadshotUrl}" Initials="{Binding Initials}"/>
                                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                          <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding Name, Mode=OneWay, StringFormat=@{0}}" Foreground="{DynamicResource Muted}"/>
                                        </TextBlock>
                                        <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" Margin="0" Width="30" Height="30" FontSize="11"
                                                ToolTip="Remove: they can't join anymore"
                                                Command="{Binding DataContext.RemoveConfigMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,6,0,0">
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                  <TextBox Text="{Binding ConfigAddName, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" ToolTip="Their username"/>
                                  <TextBlock Text="Username to add" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Muted}">
                                    <TextBlock.Style>
                                      <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ConfigAddName}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                      </Style>
                                    </TextBlock.Style>
                                  </TextBlock>
                                  <Button Grid.Column="1" Content="Add people" ctl:Btn.Icon="&#xE8FA;" Margin="8,0,0,0" Command="{Binding AddConfigMemberCommand}"/>
                                </Grid>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </Border>

                        <!-- the link -->
                        <Border Background="{DynamicResource Card2}" CornerRadius="14" Padding="16,12" Margin="0,8,0,0">
                          <StackPanel>
                            <Grid>
                              <TextBlock Text="Private server link" FontWeight="SemiBold" VerticalAlignment="Center"/>
                              <Button HorizontalAlignment="Right" Margin="0" Command="{Binding RegenerateConfigLinkCommand}"
                                      IsEnabled="{Binding ConfigActive}" Content="{Binding ConfigRegenerateText}">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding ConfigRegenerateArmed}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Red}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                              </Button>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                              <TextBox Text="{Binding ConfigLink, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Padding="10,8"/>
                              <Button Grid.Column="1" Content="Copy" ctl:Btn.Icon="&#xE8C8;" Margin="8,0,0,0" Command="{Binding CopyConfigLinkCommand}"/>
                            </Grid>
                            <TextBlock FontSize="12" Margin="0,6,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Anyone with this link can join. Regenerate makes a new one and the old one stops working."/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </ctl:StateView>
                </Grid>
              </Border>
            </Grid>

            <!-- Multi-launch → Where to?: search a game, or pick one of your private servers -->
            <Grid Visibility="{Binding ShowTargetPicker, Converter={StaticResource BoolVis}}" Background="#B0000000">
              <Border Style="{StaticResource CardBox}" Width="640" Height="600" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource Card}">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Grid Margin="26,22,22,0">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton Style="{StaticResource Seg}" Content="Search games" GroupName="targetpicker"
                                   IsChecked="{Binding TargetPickerTab, Converter={StaticResource Eq}, ConverterParameter=Games, Mode=TwoWay}"/>
                      <RadioButton Style="{StaticResource Seg}" Content="My private servers" GroupName="targetpicker" Margin="0"
                                   IsChecked="{Binding TargetPickerTab, Converter={StaticResource Eq}, ConverterParameter=Servers, Mode=TwoWay}"/>
                    </StackPanel>
                    <Button Style="{StaticResource IconBtn}" Content="&#xE711;" HorizontalAlignment="Right" Margin="0" ToolTip="Close"
                            Command="{Binding CloseTargetPickerCommand}"/>
                  </Grid>
                  <Grid Grid.Row="1" Margin="26,14,26,0">
                    <ctl:SearchBox Text="{Binding TargetGameSearch}" Placeholder="Search games, press Enter" SubmitCommand="{Binding SearchTargetGamesCommand}"
                                   Visibility="{Binding TargetPickerTab, Converter={StaticResource PageVis}, ConverterParameter=Games}"/>
                    <Grid Visibility="{Binding TargetPickerTab, Converter={StaticResource PageVis}, ConverterParameter=Servers}">
                      <TextBlock Text="Pick one to launch into it. Its share link is filled in, so every account you launch can join."
                                 TextWrapping="Wrap" FontSize="12" Style="{StaticResource MutedText}" Margin="0,0,44,0" VerticalAlignment="Center"/>
                      <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" HorizontalAlignment="Right" Margin="0" ToolTip="Load again"
                              Command="{Binding RefreshMyServersCommand}"/>
                    </Grid>
                  </Grid>

                  <!-- games -->
                  <ctl:StateView Grid.Row="2" Margin="0,12,0,0" State="{Binding TargetGamesLoad.State}" Message="{Binding TargetGamesLoad.Message}"
                                 EmptyText="No games found." Visibility="{Binding TargetPickerTab, Converter={StaticResource PageVis}, ConverterParameter=Games}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding TargetGameHits}" Margin="26,0,26,20">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Margin="0,0,0,6" Padding="10,8" HorizontalContentAlignment="Stretch" Cursor="Hand" Focusable="False"
                                    Command="{Binding DataContext.PickTargetGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                              <Button.Template>
                                <ControlTemplate TargetType="Button">
                                  <Border x:Name="b" Background="{DynamicResource Card2}" CornerRadius="12" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                                  <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHover}"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                              </Button.Template>
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <ctl:RemoteImage Url="{Binding IconUrl}" Width="48" Height="48" CornerRadius="10"/>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding PlayingText}" FontSize="12" Margin="0,2,0,0" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </ctl:StateView>

                  <!-- your private servers -->
                  <ctl:StateView Grid.Row="2" Margin="0,12,0,0" State="{Binding MyServersLoad.State}" Message="{Binding MyServersLoad.Message}"
                                 EmptyText="This account has no private servers yet." RetryCommand="{Binding RefreshMyServersCommand}"
                                 Visibility="{Binding TargetPickerTab, Converter={StaticResource PageVis}, ConverterParameter=Servers}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding MyServers}" Margin="26,0,26,20">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Background="{DynamicResource Card2}" CornerRadius="12" Padding="10,8" Margin="0,0,0,6">
                              <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ctl:RemoteImage Url="{Binding IconUrl}" Width="48" Height="48" CornerRadius="10"/>
                                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock FontSize="12" Margin="0,2,0,0" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding GameName, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SubText, Mode=OneWay}"/>
                                  </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                  <Button Content="Settings" ctl:Btn.Icon="&#xE713;" Padding="12,0" Height="38" VerticalAlignment="Center"
                                          Command="{Binding DataContext.OpenMyServerSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                  <Button Content="Use" Style="{StaticResource Primary}" Padding="18,0" Height="38" VerticalAlignment="Center" Margin="0"
                                          Command="{Binding DataContext.PickMyServerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </ctl:StateView>
                </Grid>
              </Border>
            </Grid>

            <!-- toast: bottom centre, or top centre while the launch queue panel is in the corner -->
            <Border Padding="14,10,18,10" Background="{DynamicResource Card}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                    CornerRadius="12" MaxWidth="620"
                    Visibility="{Binding StatusMessage, Converter={StaticResource EmptyCollapsed}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="HorizontalAlignment" Value="Center"/>
                  <Setter Property="VerticalAlignment" Value="Bottom"/>
                  <Setter Property="Margin" Value="0,0,0,24"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding QueueVisible}" Value="True">
                      <Setter Property="VerticalAlignment" Value="Top"/>
                      <Setter Property="Margin" Value="0,18,0,0"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" Color="Black"/></Border.Effect>
              <StackPanel Orientation="Horizontal">
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0" VerticalAlignment="Top">
                  <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>

            <!-- launch queue -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Width="360" Padding="16,14"
                    Background="{DynamicResource Card2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                    Visibility="{Binding QueueVisible, Converter={StaticResource BoolVis}}">
              <StackPanel>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding QueueTitle, Mode=OneWay}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding QueueSubtitle, Mode=OneWay}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding QueueSubtitle, Converter={StaticResource EmptyCollapsed}}"/>
                  </StackPanel>
                  <Button Style="{StaticResource IconBtn}" Content="&#xE8BB;" Width="26" Height="26" FontSize="10"
                          HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Hide"
                          Command="{Binding DismissQueueCommand}"
                          Visibility="{Binding QueueRunning, Converter={StaticResource BoolVisInv}}"/>
                </Grid>
                <ProgressBar Height="4" Margin="0,10,0,8" Maximum="100" Value="{Binding QueueProgress, Mode=OneWay}"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding LaunchQueue}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,3">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="22"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                          <TextBlock Grid.Column="1" Text="{Binding State, Mode=OneWay}" FontSize="12" Margin="8,0,4,0"
                                     Foreground="{Binding State, Converter={StaticResource QueueBrush}}"/>
                          <Button Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#xE711;" Width="20" Height="20"
                                  FontSize="9" Margin="0" ToolTip="Skip this one"
                                  Command="{Binding DataContext.SkipItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding IsWaiting, Converter={StaticResource BoolVis}}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding QueueRunning, Converter={StaticResource BoolVis}}">
                  <Button Content="{Binding QueuePauseText, Mode=OneWay}" Padding="12,6" Command="{Binding ToggleQueuePauseCommand}"/>
                  <Button Content="Skip next" Padding="12,6" Command="{Binding SkipNextCommand}"/>
                  <Button Content="Cancel" Padding="12,6" Margin="0" Command="{Binding CancelQueueCommand}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
