<Window x:Class="AltDeck.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Width="520" Height="500" MinHeight="340" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock x:Name="Small" Text="Update available" Style="{StaticResource MutedText}" FontSize="12"/>
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Margin="0,2,0,4"/>
      <TextBlock x:Name="Sub" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,14"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="18,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Notes" TextWrapping="Wrap" LineHeight="21"/>
      </ScrollViewer>
    </Border>

    <!-- download progress, shown after "Update" -->
    <StackPanel Grid.Row="2" x:Name="ProgressPanel" Margin="0,16,0,0" Visibility="Collapsed">
      <Grid>
        <TextBlock x:Name="ProgressText" Text="Starting download…" FontSize="12"/>
        <TextBlock x:Name="PercentText" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Accent}"/>
      </Grid>
      <ProgressBar x:Name="Bar" Height="6" Margin="0,8,0,0" Maximum="100"
                   Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <CheckBox x:Name="DontAsk" Content="Don't notify me about updates again" VerticalAlignment="Center"
                ToolTip="You can still check by hand under Settings → About"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="LaterBtn" Content="Not now" Click="Later_Click"/>
        <Button x:Name="UpdateBtn" Style="{StaticResource Primary}" Margin="0" Click="Update_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
