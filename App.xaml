<Application x:Class="AltDeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AltDeck"
             xmlns:ctl="clr-namespace:AltDeck.Controls">
  <Application.Resources>
    <!-- palette (ThemeManager swaps these at runtime) -->
    <SolidColorBrush x:Key="Bg" Color="#0A0B0D"/>
    <SolidColorBrush x:Key="Page" Color="#101215"/>
    <SolidColorBrush x:Key="Card" Color="#15181B"/>
    <SolidColorBrush x:Key="Card2" Color="#1C1F23"/>
    <SolidColorBrush x:Key="Line" Color="#272A30"/>
    <SolidColorBrush x:Key="Fg" Color="#F2F3F5"/>
    <SolidColorBrush x:Key="Muted" Color="#9AA0A8"/>
    <SolidColorBrush x:Key="Accent" Color="#FF8A1F"/>
    <SolidColorBrush x:Key="AccentFg" Color="#0B0C0E"/>
    <SolidColorBrush x:Key="Blue" Color="#4DA3FF"/>
    <SolidColorBrush x:Key="Orange" Color="#FF8A3D"/>
    <SolidColorBrush x:Key="Red" Color="#FF5A5F"/>
    <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <local:EqualsConverter x:Key="Eq"/>
    <local:PageVisibleConverter x:Key="PageVis"/>
    <local:StatusBrushConverter x:Key="StatusBrush"/>
    <local:GroupBrushConverter x:Key="GroupBrush"/>
    <local:NullToCollapsedConverter x:Key="NullCollapsed"/>
    <local:EmptyToCollapsedConverter x:Key="EmptyCollapsed"/>
    <local:InverseBoolVisibilityConverter x:Key="BoolVisInv"/>
    <local:InverseBoolConverter x:Key="Not"/>
    <local:QueueStateBrushConverter x:Key="QueueBrush"/>
    <local:LogKindBrushConverter x:Key="LogBrush"/>
    <local:CountToVisibilityConverter x:Key="CountVis"/>

    <!-- ===== text + containers ===== -->
    <Style x:Key="MutedText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    </Style>
    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <!-- ===== buttons ===== -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource Red}"/>
    </Style>
    <Style x:Key="Subtle" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Subtle}">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Big" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid MinHeight="72">
              <Rectangle x:Name="dash" RadiusX="14" RadiusY="14" Stroke="{DynamicResource Line}" StrokeThickness="1.5" StrokeDashArray="4 4"/>
              <Border x:Name="fill" Background="{DynamicResource Accent}" CornerRadius="14" Visibility="Collapsed"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="True">
                <Setter TargetName="fill" Property="Visibility" Value="Visible"/>
                <Setter TargetName="dash" Property="Visibility" Value="Collapsed"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="fill" Property="Opacity" Value="0.9"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Chip}">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- ===== toggles / radios ===== -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="track" Width="46" Height="26" CornerRadius="13" Background="{DynamicResource Card2}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Ellipse x:Name="thumb" Width="18" Height="18" Fill="{DynamicResource Muted}"
                       HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource AccentFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="20" Height="20" CornerRadius="6" BorderThickness="1.5"
                      BorderBrush="{DynamicResource Muted}" Background="Transparent" VerticalAlignment="Center">
                <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="12"
                           Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="16,8">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="30"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Switch at the size used on the Performance page -->
    <Style x:Key="SwitchLarge" TargetType="ToggleButton" BasedOn="{StaticResource Switch}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="track" Width="50" Height="28" CornerRadius="14" Background="{DynamicResource Card2}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Ellipse x:Name="thumb" Width="20" Height="20" Fill="{DynamicResource Muted}"
                       HorizontalAlignment="Left" Margin="4,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource AccentFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Round "selected" dot on a preset card: filled with the accent when its card is chosen -->
    <Style x:Key="RadioDot" TargetType="Border">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Background" Value="{DynamicResource Page}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource Accent}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Thin outlined track with a round thumb -->
    <Style x:Key="PerfSlider" TargetType="Slider">
      <Setter Property="Height" Value="28"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" Height="28">
              <Border Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="2,0"
                      Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"/>
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="26" Height="26" Focusable="False" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource Card2}" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PresetCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                    CornerRadius="18" Padding="20">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Swatch" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Width="34" Height="34">
              <Ellipse x:Name="ring" Stroke="Transparent" StrokeThickness="2"/>
              <Ellipse Width="24" Height="24" Fill="{TemplateBinding Background}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Fg}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PickCard" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
      <Setter Property="Width" Value="300"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="14,12">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== inputs ===== -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5" CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="12,8">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="MinWidth" Value="150"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="tb" ClickMode="Press" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1.5"
                            CornerRadius="10" Padding="14,9">
                      <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                 Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="14,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     PopupAnimation="Fade">
                <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        CornerRadius="10" Padding="4" Margin="0,4,0,0"
                        MinWidth="{Binding ActualWidth, ElementName=tb}">
                  <ScrollViewer MaxHeight="260"><StackPanel IsItemsHost="True"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== lists, scrollbars, menus ===== -->
    <Style x:Key="Row" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="8,0" Margin="0,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- scrollbar: a thin rounded handle on an invisible track. Wider and brighter on hover, orange while dragged.
         Kept clear of the page's rounded corners. Horizontal bars are hidden (rows scroll with buttons / Shift + wheel). -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="14"/>
      <Setter Property="MinWidth" Value="14"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Margin" Value="0,10,2,10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="Bar" Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="36">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Handle" Width="5" CornerRadius="3" HorizontalAlignment="Right" Margin="0,0,3,0"
                                Background="{DynamicResource Muted}" Opacity="0.35"/>
                        <ControlTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Handle" Property="Width" Value="8"/>
                            <Setter TargetName="Handle" Property="CornerRadius" Value="4"/>
                            <Setter TargetName="Handle" Property="Opacity" Value="0.6"/>
                          </DataTrigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Handle" Property="Width" Value="8"/>
                            <Setter TargetName="Handle" Property="CornerRadius" Value="4"/>
                            <Setter TargetName="Handle" Property="Opacity" Value="1"/>
                            <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Accent}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="10" Padding="4">
              <StackPanel IsItemsHost="True"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- the line between menu items: a thin dark line instead of Windows' white one -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="10,5" Background="{DynamicResource Line}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== settings row ===== -->
    <Style TargetType="ctl:SettingRow">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ctl:SettingRow">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold"/>
                    <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="7" Background="{DynamicResource Card2}"
                            VerticalAlignment="Center"
                            Visibility="{Binding Soon, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVis}}">
                      <TextBlock Text="soon" FontSize="10" Style="{StaticResource MutedText}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{TemplateBinding Description}" FontSize="{TemplateBinding DescriptionSize}" TextWrapping="Wrap" Margin="0,3,0,0"
                             Style="{StaticResource MutedText}"/>
                </StackPanel>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- StateView: a page's content, or Loading / Empty / Error in its place (Controls/StateView.cs) -->
    <Style TargetType="ctl:StateView">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ctl:StateView">
            <Grid>
              <ContentPresenter x:Name="Body"/>
              <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="240">
                <ProgressBar IsIndeterminate="True" Height="4" Foreground="{DynamicResource Accent}"
                             Background="{DynamicResource Line}" BorderThickness="0"/>
                <TextBlock Text="{TemplateBinding Message}" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Muted}" FontSize="12"/>
              </StackPanel>
              <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Muted}"/>
                <TextBlock Text="{TemplateBinding EmptyText}" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource Muted}"/>
              </StackPanel>
              <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                <TextBlock Text="&#xE783;" FontFamily="{StaticResource Icons}" FontSize="28" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Red}"/>
                <TextBlock Text="{TemplateBinding Message}" Margin="0,12,0,14" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="Try again" HorizontalAlignment="Center" Margin="0" Command="{TemplateBinding RetryCommand}"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="State" Value="Loading">
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="LoadingPanel" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="State" Value="Empty">
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="EmptyPanel" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="State" Value="Error">
                <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="ErrorPanel" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A game tile (Home rows, Games page). Click opens the game page; the ▶ plays with the account top right;
         right-click for more. Works inside any page whose DataContext is the main view-model. -->
    <DataTemplate x:Key="GameTileTemplate">
      <Grid x:Name="Root" Width="160" Margin="0,0,14,14">
        <Button Padding="0" Cursor="Hand" HorizontalContentAlignment="Stretch" ToolTip="{Binding Name}"
                Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                      CornerRadius="14">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                  <Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Button.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Open game page" Command="{Binding OpenGameCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
              <MenuItem Command="{Binding PlayGameCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Header>
                  <TextBlock><Run Text="Play with"/> <Run Text="{Binding CurrentAccount.Label, Mode=OneWay, FallbackValue='this account'}"/></TextBlock>
                </MenuItem.Header>
              </MenuItem>
              <MenuItem Header="Play with several alts…" Command="{Binding PlayGameWithAltsCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
              <Separator/>
              <MenuItem Header="Open on roblox.com" Command="{Binding OpenGameOnWebCommand}"
                        CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            </ContextMenu>
          </Button.ContextMenu>
          <StackPanel>
            <!-- 1 px inside the border, so the picture's corners sit exactly in the card's -->
            <ctl:RemoteImage Url="{Binding IconUrl}" Height="158" CornerRadius="13" TopCornersOnly="True"/>
            <StackPanel Margin="10,9,10,10">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                <TextBlock Text="&#xE8E1;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}" Margin="0,0,4,0"
                           Visibility="{Binding HasLikes, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding LikeText}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding PlayingText}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Button>
        <!-- quick play -->
        <Button Width="40" Height="40" Margin="0,110,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                ToolTip="Play now with the account top right"
                Command="{Binding DataContext.PlayGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border CornerRadius="20" Background="{DynamicResource Accent}">
                      <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource AccentFg}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                  <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
      </Grid>
    </DataTemplate>
  </Application.Resources>
</Application>
