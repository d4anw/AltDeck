<Window x:Class="AltDeck.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource Card2}"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
  </Window.Resources>
  <StackPanel Margin="22">
    <TextBlock x:Name="Prompt" Margin="0,0,0,14" TextWrapping="Wrap"/>
    <StackPanel x:Name="Fields"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Red}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="CancelBtn" Content="Cancel" IsCancel="True"/>
      <Button Content="OK" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
