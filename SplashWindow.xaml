<Window x:Class="RoDeck.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        Width="440" Height="300" Foreground="{DynamicResource Fg}" Title="RoDeck">
  <Grid Margin="24">
    <Border Background="{DynamicResource Page}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="22">
      <Border.Effect>
        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.45" Color="Black"/>
      </Border.Effect>
      <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <!-- the same little logo as the title bar, drawn bigger -->
          <Grid Width="72" Height="72" HorizontalAlignment="Center">
            <Rectangle x:Name="SqA" Width="36" Height="36" Fill="{DynamicResource Accent}" RadiusX="9" RadiusY="9"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Rectangle x:Name="SqB" Width="28" Height="28" Fill="{DynamicResource Muted}" RadiusX="8" RadiusY="8"
                       HorizontalAlignment="Right" VerticalAlignment="Top"/>
            <Rectangle x:Name="SqC" Width="36" Height="36" Fill="{DynamicResource Accent}" RadiusX="9" RadiusY="9"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
          </Grid>
          <TextBlock x:Name="Title1" Text="RoDeck" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" Opacity="0">
            <TextBlock.RenderTransform><TranslateTransform x:Name="TitleShift" Y="12"/></TextBlock.RenderTransform>
          </TextBlock>
          <TextBlock x:Name="Tagline" Text="All your Roblox in one app" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                     Opacity="0" Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <!-- thin progress line along the bottom -->
        <Border Height="3" VerticalAlignment="Bottom" Margin="44,0,44,26" CornerRadius="2" Background="{DynamicResource Line}">
          <Border x:Name="Fill" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="FillScale" ScaleX="0"/></Border.RenderTransform>
          </Border>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
