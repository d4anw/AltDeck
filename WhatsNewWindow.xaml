<Window x:Class="RoDeck.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new" Width="520" Height="460" MinHeight="300" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="RoDeck was updated" Style="{StaticResource MutedText}" FontSize="12"/>
      <TextBlock x:Name="Heading" FontSize="22" FontWeight="Bold" Margin="0,2,0,14"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource CardBox}" Padding="18,14">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Notes" TextWrapping="Wrap" LineHeight="21"/>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="See it on GitHub" Click="GitHub_Click"/>
      <Button Content="Got it" Style="{StaticResource Primary}" IsDefault="True" IsCancel="True" Margin="0" Click="GotIt_Click"/>
    </StackPanel>
  </Grid>
</Window>
