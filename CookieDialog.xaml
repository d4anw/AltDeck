<Window x:Class="AltDeck.CookieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add accounts with cookies" Width="560" Height="360" MinHeight="300" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,10">
      <TextBlock Text="Paste the .ROBLOSECURITY cookie of each of your own accounts." TextWrapping="Wrap"/>
      <TextBlock Text="One account or many: put each cookie on its own line." TextWrapping="Wrap"
                 Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>
    <TextBox Grid.Row="1" x:Name="Input" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="11"
             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="Input_TextChanged"/>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="Count" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="12"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True"/>
        <Button x:Name="AddBtn" Content="Add" Style="{StaticResource Primary}" Click="Ok_Click" Margin="0"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
