<Window x:Class="AltDeck.CookieDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account with cookie" Width="520" Height="260" ResizeMode="NoResize"
        Background="{DynamicResource Page}" Foreground="{DynamicResource Fg}"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="Paste the .ROBLOSECURITY cookie for your own account." Margin="0,0,0,10"/>
    <TextBox x:Name="Input" Height="100" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True"/>
      <Button Content="Add" Style="{StaticResource Primary}" IsDefault="True" Click="Ok_Click" Margin="0"/>
    </StackPanel>
  </StackPanel>
</Window>
