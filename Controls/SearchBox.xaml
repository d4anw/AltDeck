<UserControl x:Class="AltDeck.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <!-- 🔍 + text + grey hint while empty + ✕ to clear. Enter runs SubmitCommand. Used on every page. -->
  <Grid>
    <TextBox x:Name="Box" Padding="34,9,34,9"
             Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
             KeyDown="Box_KeyDown"/>
    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Margin="13,0,0,0"
               VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource Muted}"/>
    <TextBlock x:Name="Hint" Text="{Binding Placeholder, ElementName=Root}" Margin="36,0,34,0" VerticalAlignment="Center"
               IsHitTestVisible="False" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
    <Button x:Name="Clear" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Width="26" Height="26"
            Cursor="Hand" ToolTip="Clear" Click="Clear_Click" Visibility="Collapsed" Focusable="False">
      <Button.Template>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" CornerRadius="13" Background="Transparent">
            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="10" Foreground="{DynamicResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Card2}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Button.Template>
    </Button>
  </Grid>
</UserControl>
