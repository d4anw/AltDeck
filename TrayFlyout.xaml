<Window x:Class="RoDeck.TrayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:RoDeck.Controls"
        Title="RoDeck" Width="360" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Fg}">
  <!-- the panel that opens from RoDeck's tray icon: a quick look at what RoDeck is doing, and the main switches -->
  <Border Margin="14" CornerRadius="18" Background="{DynamicResource Page}" BorderBrush="{DynamicResource CardEdge}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
    </Border.Effect>
    <Grid>
      <Border CornerRadius="18" Background="{DynamicResource PageGlow}" IsHitTestVisible="False"/>
      <StackPanel Margin="18,16,18,16">
        <!-- header: logo, name, the account in use -->
        <Grid Margin="0,0,0,14">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="18" Height="18" Margin="0,0,10,0">
              <Rectangle Width="9" Height="9" Fill="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Top" RadiusX="2" RadiusY="2"/>
              <Rectangle Width="9" Height="9" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"/>
              <Rectangle Width="7" Height="7" Fill="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" RadiusX="2" RadiusY="2"/>
            </Grid>
            <TextBlock Text="RoDeck" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentAccount.Label}" FontSize="12" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       Margin="0,0,8,0" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
            <ctl:AvatarView Width="26" Height="26" Url="{Binding CurrentAccount.AvatarUrl}" Initials="{Binding CurrentAccount.Initials}"/>
          </StackPanel>
        </Grid>

        <!-- trade ad -->
        <Border Style="{StaticResource CardBox}" Padding="16,13" Margin="0,0,0,10">
          <StackPanel>
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0">
                  <TextBlock Text="&#xE789;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Trade ad" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding AdRunning}" Value="True"><Setter Property="Fill" Value="#3DD68C"/></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Start" Style="{StaticResource Primary}" Margin="0" Padding="16,6" Command="{Binding StartAdCommand}"
                        IsEnabled="{Binding CanStartAd}" Visibility="{Binding AdRunning, Converter={StaticResource BoolVisInv}}"/>
                <Button Content="Stop" Margin="0" Padding="16,6" Command="{Binding StopAdCommand}"
                        Visibility="{Binding AdRunning, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding AdStatus}" FontSize="12" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="40,6,0,0"/>
          </StackPanel>
        </Border>

        <!-- clients -->
        <Border Style="{StaticResource CardBox}" Padding="16,13" Margin="0,0,0,10">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentSoft}" Margin="0,0,10,0">
                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock VerticalAlignment="Center">
                <Run Text="{Binding RunningCount, Mode=OneWay}" FontWeight="Bold"/> <Run Text="Roblox clients running"/>
              </TextBlock>
            </StackPanel>
            <Button Content="Stop all" HorizontalAlignment="Right" Margin="0" Padding="14,6" Style="{StaticResource Danger}"
                    Click="StopAll_Click" Visibility="{Binding RunningCount, Converter={StaticResource CountVis}}"/>
          </Grid>
        </Border>

        <!-- what else is going on -->
        <StackPanel Orientation="Horizontal" Margin="4,2,0,14">
          <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                     Style="{StaticResource MutedText}"/>
          <TextBlock FontSize="12" Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{Binding TrayNotifyText}"/>
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Style="{StaticResource Primary}" Margin="0" Padding="16,10" Click="Open_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Open RoDeck"/>
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Margin="0" Padding="16,10" Click="Quit_Click" ToolTip="Close RoDeck completely (stops the trade ad and notifications)">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="Quit"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
